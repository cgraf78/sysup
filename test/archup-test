echo ""
echo "=== archup: AUR lookup failures ==="

_archup_mock_reset
_archup_mock_add_package local-only 0 ok
result=$(warn_non_aur_foreign_packages 2>&1)
_assert_contains "archup AUR lookup: confirmed absence remains visible" \
  "foreign packages not found in AUR" "$result"
_assert_not_contains "archup AUR lookup: confirmed absence is not called unverified" \
