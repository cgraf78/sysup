#!/usr/bin/env bash
# archup-test - unit tests for the Arch upgrade helper.

set -euo pipefail
export NO_COLOR=1

TEST_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd "$TEST_DIR/.." && pwd)
# shellcheck source=lib/test.sh
. "$TEST_DIR/lib/test.sh"

export SYSUP_SOURCE_ONLY=1
# Never read or write the host's deferred-restart state or boot identity.
SYSUP_STATE_DIR="$(_tmpdir)/state"
SYSUP_BOOT_ID_FILE="$(_tmpdir)/boot_id"
# shellcheck source=../lib/sysup/archup
. "$REPO_ROOT/lib/sysup/archup"

echo "=== archup: conditional AUR rebuilds ==="

_archup_mock_reset() {
  ARCHUP_MOCK_ROOT=$(_tmpdir)
  ARCHUP_YAY_COMMAND_LOG="$ARCHUP_MOCK_ROOT/yay-commands.log"
  ARCHUP_SUDO_COMMAND_LOG="$ARCHUP_MOCK_ROOT/sudo-commands.log"
  ARCHUP_PACMAN_COMMAND_LOG="$ARCHUP_MOCK_ROOT/pacman-commands.log"
  ARCHUP_PACDIFF_COMMAND_LOG="$ARCHUP_MOCK_ROOT/pacdiff-commands.log"
  : >"$ARCHUP_YAY_COMMAND_LOG"
  : >"$ARCHUP_SUDO_COMMAND_LOG"
  : >"$ARCHUP_PACMAN_COMMAND_LOG"
  : >"$ARCHUP_PACDIFF_COMMAND_LOG"
  ARCHUP_PACKAGES=()
  declare -gA ARCHUP_PACKAGE_FILES=()
  declare -gA ARCHUP_PACKAGE_VERSIONS=()
  declare -gA ARCHUP_PACKAGE_UPGRADE_VERSIONS=()
  declare -gA ARCHUP_AUR_PACKAGES=()
  declare -gA ARCHUP_LDD_OUTPUT=()
  ARCHUP_LDD_REJECTED_FILES=""
  ARCHUP_ACTIVE_UNITS=()
  ARCHUP_NON_RESTARTABLE_UNITS=""
  ARCHUP_NON_RESTARTABLE_AFTER_RELOAD_UNITS=""
  ARCHUP_SYSTEMCTL_SHOW_STATUS=0
  ARCHUP_SYSTEMCTL_SHOW_MALFORMED=0
  ARCHUP_DISPLAY_MANAGER_ID="display-manager.service"
  ARCHUP_DISPLAY_MANAGER_ID_STATUS=0
  ARCHUP_FAILED_UNITS=""
  ARCHUP_DISABLED_UNITS=""
  ARCHUP_SYSTEMCTL_QUERY_STATUS=0
  ARCHUP_SYSTEMCTL_ACTIVE_QUERY_STATUS=0
  ARCHUP_NVIDIA_VERSION_FILE="$ARCHUP_MOCK_ROOT/nvidia-version"
  ARCHUP_NVIDIA_INSTALLED_VERSION=""
  ARCHUP_MODINFO_STATUS=0
  ARCHUP_YAY_FAIL_UPGRADE=0
  ARCHUP_YAY_FAIL_REBUILD=0
  ARCHUP_YAY_AUR_QUERY_STATUS=0
  ARCHUP_YAY_AUR_QUERY_ERROR=""
  ARCHUP_HAS_YAY=1
  ARCHUP_HAS_PACDIFF=1
  ARCHUP_PACDIFF_OUTPUT=""
  ARCHUP_PACDIFF_STATUS=0
  ARCHUP_IS_ROOT=0
  SYSUP_ARCH_USER=""
  SUDO_USER=""
  ARCHUP_PACMAN_FOREIGN_STATUS=0
  ARCHUP_PACMAN_FILES_STATUS=0
  ARCHUP_FILE_STATUS=0
  ARCHUP_LDD_STATUS=0
  ARCHUP_SYSTEMCTL_LOG="$ARCHUP_MOCK_ROOT/systemctl-commands.log"
  : >"$ARCHUP_SYSTEMCTL_LOG"
  declare -gA ARCHUP_ACTIVE_SINCE=()
  declare -gA ARCHUP_UNIT_STATE=()
  # No state directory yet, as on a host sysup has never deferred on.
  SYSUP_STATE_DIR="$ARCHUP_MOCK_ROOT/state"
  ARCHUP_STATE_FILE="$SYSUP_STATE_DIR/deferred-restarts"
  SYSUP_BOOT_ID_FILE="$ARCHUP_MOCK_ROOT/boot_id"
  printf 'boot-a\n' >"$SYSUP_BOOT_ID_FILE"
}

archup_is_root() {
  ((ARCHUP_IS_ROOT != 0))
}

_archup_mock_add_package() {
  local name="$1" aur="$2" libs="$3"
  local version="${4:-1.0}"
  local file="$ARCHUP_MOCK_ROOT/$name/bin/$name"

  mkdir -p "$(dirname "$file")"
  : >"$file"
  ARCHUP_PACKAGES+=("$name")
  ARCHUP_PACKAGE_FILES["$name"]="$file"
  ARCHUP_PACKAGE_VERSIONS["$name"]="$version"
  ARCHUP_AUR_PACKAGES["$name"]="$aur"
  case "$libs" in
    broken)
      ARCHUP_LDD_OUTPUT["$file"]=$'libmissing.so => not found\nlibok.so => /usr/lib/libok.so'
      ;;
    ok)
      ARCHUP_LDD_OUTPUT["$file"]=$'libok.so => /usr/lib/libok.so'
      ;;
    *)
      echo "unknown mock lib state: $libs" >&2
      return 2
      ;;
  esac
}

_archup_mock_add_debug_file() {
  local pkg="$1"
  local file="$ARCHUP_MOCK_ROOT/$pkg/debug/$pkg.debug"

  mkdir -p "$(dirname "$file")"
  : >"$file"
  ARCHUP_PACKAGE_FILES["$pkg"]+=$'\n'"$file"
  ARCHUP_LDD_REJECTED_FILES+=" $file"
}

_archup_mock_add_service() {
  local pkg="$1" unit="$2"
  ARCHUP_PACKAGE_FILES["$pkg"]+=$'\n'"/usr/lib/systemd/system/$unit"
}

pacman() {
  case "$1" in
    -Q)
      local pkg
      for pkg in "${ARCHUP_PACKAGES[@]}"; do
        printf '%s %s\n' "$pkg" "${ARCHUP_PACKAGE_VERSIONS[$pkg]}"
      done
      ;;
    -Qqm)
      if ((ARCHUP_PACMAN_FOREIGN_STATUS != 0)); then
        printf 'mock pacman foreign-package query failed\n' >&2
        return "$ARCHUP_PACMAN_FOREIGN_STATUS"
      fi
      printf '%s\n' "${ARCHUP_PACKAGES[@]}"
      ;;
    -Qlq)
      if ((ARCHUP_PACMAN_FILES_STATUS != 0)); then
        printf 'mock pacman file listing failed for %s\n' "$2" >&2
        return "$ARCHUP_PACMAN_FILES_STATUS"
      fi
      printf '%s\n' "${ARCHUP_PACKAGE_FILES[$2]:-}"
      ;;
    -Syu)
      printf '%s\n' "$*" >>"$ARCHUP_PACMAN_COMMAND_LOG"
      ;;
    *)
      echo "unexpected pacman args: $*" >&2
      return 2
      ;;
  esac
}

# Let the fallback test hide the yay function without changing PATH or the
# command lookup behavior used by the rest of the suite.
# shellcheck disable=SC2329 # Exercised indirectly by the sourced backend.
command() {
  if [[ "${1:-}" == "-v" && "${2:-}" == yay ]]; then
    ((ARCHUP_HAS_YAY != 0)) || return 1
    printf 'yay\n'
    return 0
  fi
  if [[ "${1:-}" == "-v" && "${2:-}" == pacdiff ]]; then
    ((ARCHUP_HAS_PACDIFF != 0)) || return 1
    printf 'pacdiff\n'
    return 0
  fi

  builtin command "$@"
}

pacdiff() {
  printf '%s\n' "$*" >>"$ARCHUP_PACDIFF_COMMAND_LOG"
  printf '%s\n' "$ARCHUP_PACDIFF_OUTPUT"
  return "$ARCHUP_PACDIFF_STATUS"
}

id() {
  local user

  [[ "${1:-}" == -u ]] || {
    printf 'unexpected id args: %s\n' "$*" >&2
    return 2
  }
  shift
  [[ "${1:-}" == -- ]] && shift
  user="${1:-}"
  case "$user" in
    chris) printf '1000\n' ;;
    root) printf '0\n' ;;
    *) return 1 ;;
  esac
}

yay() {
  if [[ "$1" == "-Si" && "$2" == "--aur" ]]; then
    if ((ARCHUP_YAY_AUR_QUERY_STATUS != 0)); then
      printf '%s\n' "$ARCHUP_YAY_AUR_QUERY_ERROR" >&2
      printf ' -> No AUR package found for %s\n' "$3" >&2
      return "$ARCHUP_YAY_AUR_QUERY_STATUS"
    fi
    if [[ "${ARCHUP_AUR_PACKAGES[$3]:-0}" == 1 ]]; then
      return 0
    fi
    printf ' -> No AUR package found for %s\n' "$3" >&2
    return 1
  fi

  if [[ "$1" == "-Syu" ]]; then
    if ((ARCHUP_YAY_FAIL_UPGRADE != 0)); then
      return "$ARCHUP_YAY_FAIL_UPGRADE"
    fi

    local pkg
    for pkg in "${!ARCHUP_PACKAGE_UPGRADE_VERSIONS[@]}"; do
      ARCHUP_PACKAGE_VERSIONS["$pkg"]="${ARCHUP_PACKAGE_UPGRADE_VERSIONS[$pkg]}"
    done
  fi

  if [[ "$1" == "-S" && "$2" == "--aur" ]] && ((ARCHUP_YAY_FAIL_REBUILD != 0)); then
    return "$ARCHUP_YAY_FAIL_REBUILD"
  fi

  printf '%s\n' "$*" >>"$ARCHUP_YAY_COMMAND_LOG"
}

file() {
  if ((ARCHUP_FILE_STATUS != 0)); then
    printf 'mock file inspection failed for %s\n' "${2:-}" >&2
    return "$ARCHUP_FILE_STATUS"
  fi
  if [[ "$1" == *.service ]]; then
    printf 'ASCII text\n'
    return
  fi
  printf 'ELF 64-bit LSB pie executable, dynamically linked\n'
}

ldd() {
  if ((ARCHUP_LDD_STATUS != 0)); then
    printf 'mock ldd inspection failed for %s\n' "$1" >&2
    return "$ARCHUP_LDD_STATUS"
  fi
  if [[ " $ARCHUP_LDD_REJECTED_FILES " == *" $1 "* ]]; then
    printf '\tnot a dynamic executable\n' >&2
    return 1
  fi
  printf '%s\n' "${ARCHUP_LDD_OUTPUT[$1]:-}"
}

# shellcheck disable=SC2329 # Exercised indirectly by the backend restart policy.
modinfo() {
  if ((ARCHUP_MODINFO_STATUS != 0)); then
    printf 'mock modinfo failure\n' >&2
    return "$ARCHUP_MODINFO_STATUS"
  fi
  [[ "$*" == "-F version nvidia" ]] || {
    printf 'unexpected modinfo args: %s\n' "$*" >&2
    return 2
  }
  printf '%s\n' "$ARCHUP_NVIDIA_INSTALLED_VERSION"
}

# shellcheck disable=SC2329 # Exercised indirectly by the shared driver.
sudo() {
  printf '%s\n' "$*" >>"$ARCHUP_SUDO_COMMAND_LOG"
  if [[ "${1:-}" == "-v" ]]; then
    return 0
  fi

  if [[ "${1:-}" == "-u" ]]; then
    shift 2
    [[ "${1:-}" == "-H" ]] && shift
    [[ "${1:-}" == "--" ]] && shift
  fi

  "$@"
}

# shellcheck disable=SC2329 # Exercised indirectly by the shared systemd helpers.
systemctl() {
  case "$1" in
    list-units)
      if ((ARCHUP_SYSTEMCTL_ACTIVE_QUERY_STATUS != 0)); then
        printf 'Failed to connect to bus: Connection refused\n' >&2
        return "$ARCHUP_SYSTEMCTL_ACTIVE_QUERY_STATUS"
      fi
      local unit
      for unit in "${ARCHUP_ACTIVE_UNITS[@]}"; do
        printf '%s loaded active running mock unit\n' "$unit"
      done
      ;;
    show)
      if ((ARCHUP_SYSTEMCTL_SHOW_STATUS != 0)); then
        printf 'Failed to query unit properties\n' >&2
        return "$ARCHUP_SYSTEMCTL_SHOW_STATUS"
      fi
      local unit="${!#}"
      # An unset display-manager.service alias reports its own name.
      if [[ "$2" == --property=Id && "$unit" == display-manager.service ]]; then
        if ((ARCHUP_DISPLAY_MANAGER_ID_STATUS != 0)); then
          printf 'Failed to get properties: Access denied\n' >&2
          return "$ARCHUP_DISPLAY_MANAGER_ID_STATUS"
        fi
        printf '%s\n' "$ARCHUP_DISPLAY_MANAGER_ID"
        return 0
      fi
      if [[ "$*" == *--property=ActiveState* ]]; then
        if [[ -n "${ARCHUP_UNIT_STATE[$unit]:-}" ]]; then
          printf 'ActiveState=%s\n' "${ARCHUP_UNIT_STATE[$unit]}"
        elif [[ " ${ARCHUP_ACTIVE_UNITS[*]} " == *" $unit "* ]]; then
          printf 'ActiveState=active\n'
        else
          printf 'ActiveState=inactive\n'
        fi
        printf 'ActiveEnterTimestampMonotonic=%s\n' "${ARCHUP_ACTIVE_SINCE[$unit]:-100}"
        return 0
      fi
      if ((ARCHUP_SYSTEMCTL_SHOW_MALFORMED != 0)); then
        printf 'unknown\n'
        return 0
      fi
      if [[ " $ARCHUP_NON_RESTARTABLE_UNITS " == *" $unit "* ]] ||
        { [[ " $ARCHUP_NON_RESTARTABLE_AFTER_RELOAD_UNITS " == *" $unit "* ]] &&
          [[ "$(cat "$ARCHUP_SYSTEMCTL_LOG")" == *daemon-reload* ]]; }; then
        printf 'no\n'
      else
        printf 'yes\n'
      fi
      ;;
    daemon-reload | try-restart | reset-failed | restart)
      printf '%s\n' "$*" >>"$ARCHUP_SYSTEMCTL_LOG"
      ;;
    --failed)
      ((ARCHUP_SYSTEMCTL_QUERY_STATUS == 0)) || {
        printf 'Failed to connect to bus: Connection refused\n' >&2
        return "$ARCHUP_SYSTEMCTL_QUERY_STATUS"
      }
      [[ -z "$ARCHUP_FAILED_UNITS" ]] || printf '%s\n' "$ARCHUP_FAILED_UNITS"
      ;;
    is-enabled)
      # $2 is the unit; the fixture lists the ones that are not enabled.
      if [[ " $ARCHUP_DISABLED_UNITS " == *" $2 "* ]]; then
        printf 'disabled\n'
      else
        printf 'enabled\n'
      fi
      ;;
    *)
      printf 'unexpected systemctl args: %s\n' "$*" >&2
      return 2
      ;;
  esac
}

# shellcheck disable=SC2329 # Exercised indirectly by sysup_main.
sysup_require_family() {
  return 0
}

_archup_mock_reset
_archup_mock_add_package eternalterminal-server 1 ok
# shellcheck disable=SC2119 # The sysup driver passes upgrade args; this call has none.
result=$(sysup_backend_upgrade 2>&1)
yay_commands=$(cat "$ARCHUP_YAY_COMMAND_LOG")
_assert_contains "archup clean: still runs system upgrade" \
  "-Syu --devel --noconfirm" "$yay_commands"
_assert_not_contains "archup clean: does not force rebuild clean AUR packages" \
  "--rebuild" "$yay_commands"
_assert_contains "archup clean: reports no broken libraries after upgrade" \
  "no broken foreign package libraries found after upgrade" "$result"

_archup_mock_reset
_archup_mock_add_package broken-aur 1 broken
_archup_mock_add_package healthy-aur 1 ok
_archup_mock_add_package broken-local 0 broken
# shellcheck disable=SC2119 # The sysup driver passes upgrade args; this call has none.
result=$(sysup_backend_upgrade 2>&1)
yay_commands=$(cat "$ARCHUP_YAY_COMMAND_LOG")
_assert_contains "archup broken: rebuilds broken AUR package" \
  "-S --aur --rebuild --redownload --answerclean All --noconfirm broken-aur" "$yay_commands"
_assert_not_contains "archup broken: does not rebuild healthy AUR package" \
  "-S --aur --rebuild --redownload --answerclean All --noconfirm healthy-aur" "$yay_commands"
_assert_not_contains "archup broken: does not pass non-AUR package to yay rebuild" \
  "-S --aur --rebuild --redownload --answerclean All --noconfirm broken-local" "$yay_commands"
_assert_contains "archup broken: reports scoped rebuild" \
  "rebuilding broken AUR packages (1)" "$result"

_archup_mock_reset
_archup_mock_add_package prompted-aur 1 ok
sysup_backend_upgrade --confirm >/dev/null
yay_commands=$(cat "$ARCHUP_YAY_COMMAND_LOG")
_assert_contains "archup confirmation: caller can restore yay prompts" \
  "-Syu --devel --confirm" "$yay_commands"
_assert_not_contains "archup confirmation: prompt override removes unattended mode" \
  "--noconfirm" "$yay_commands"

_archup_mock_reset
_archup_mock_add_package reprompt-disabled 1 ok
sysup_backend_upgrade --confirm --noconfirm >/dev/null
yay_commands=$(cat "$ARCHUP_YAY_COMMAND_LOG")
_assert_contains "archup confirmation: last caller choice wins" \
  "-Syu --devel --noconfirm" "$yay_commands"
_assert_not_contains "archup confirmation: superseded choice is removed" \
  "--confirm" "$yay_commands"

_archup_mock_reset
ARCHUP_HAS_YAY=0
sysup_backend_upgrade --confirm >/dev/null
pacman_commands=$(cat "$ARCHUP_PACMAN_COMMAND_LOG")
_assert_contains "archup fallback: pacman honors the prompt override" \
  "-Syu --confirm" "$pacman_commands"
_assert_not_contains "archup fallback: prompt override removes unattended mode" \
  "--noconfirm" "$pacman_commands"

_archup_mock_reset
_archup_mock_add_package root-sudo-user 1 ok
ARCHUP_IS_ROOT=1
SUDO_USER=chris
sysup_backend_upgrade >/dev/null
sudo_commands=$(cat "$ARCHUP_SUDO_COMMAND_LOG")
_assert_contains "archup root: warms the invoking user's sudo credential" \
  "-u chris -H -- sudo -v" "$sudo_commands"
_assert_contains "archup root: runs yay as the invoking non-root user" \
  "-u chris -H -- yay -Syu --devel --noconfirm" "$sudo_commands"

_archup_mock_reset
_archup_mock_add_package root-explicit-user 1 ok
ARCHUP_IS_ROOT=1
export SYSUP_ARCH_USER=chris
export SUDO_USER=root
sysup_backend_upgrade >/dev/null
sudo_commands=$(cat "$ARCHUP_SUDO_COMMAND_LOG")
_assert_contains "archup root: explicit user overrides an unusable SUDO_USER" \
  "-u chris -H -- yay -Syu --devel --noconfirm" "$sudo_commands"

_archup_mock_reset
ARCHUP_IS_ROOT=1
set +e
result=$(sysup_backend_upgrade 2>&1)
status=$?
set -e
_assert_eq "archup root: ambiguous AUR ownership fails closed" "1" "$status"
_assert_contains "archup root: ambiguous ownership explains the explicit override" \
  "SYSUP_ARCH_USER" "$result"
_assert_not_contains "archup root: never invokes yay as root" \
  "-Syu" "$(cat "$ARCHUP_YAY_COMMAND_LOG")"

_archup_mock_reset
ARCHUP_IS_ROOT=1
SYSUP_ARCH_USER="missing-user"
set +e
result=$(sysup_backend_upgrade 2>&1)
status=$?
set -e
_assert_eq "archup root: unknown explicit user fails closed" "1" "$status"
_assert_contains "archup root: unknown user error is actionable" \
  "existing non-root user" "$result"

usage=$(sysup_backend_usage)
_assert_contains "archup usage: documents unattended package installation" \
  "upgrade packages noninteractively" "$usage"
_assert_contains "archup usage: documents the package-manager prompt override" \
  "--confirm" "$usage"
_assert_contains "archup usage: documents checks before service restarts" \
  "check shared libraries" "$usage"
_assert_contains "archup usage: documents failed-unit reporting last" \
  "report failed systemd units" "$usage"
_assert_contains "archup usage: documents root AUR ownership" \
  "SYSUP_ARCH_USER" "$usage"

echo ""
echo "=== archup: pending package configuration ==="

_archup_mock_reset
ARCHUP_PACDIFF_OUTPUT=$'/etc/example.conf.pacnew\n/etc/removed.conf.pacsave'
result=$(report_pending_pacman_configs 2>&1)
_assert_eq "archup pending config: requests output-only pacdiff scan" \
  "--output" "$(cat "$ARCHUP_PACDIFF_COMMAND_LOG")"
_assert_contains "archup pending config: reports package config requiring review" \
  "config files awaiting a manual merge" "$result"
_assert_contains "archup pending config: reports .pacnew files" \
  "/etc/example.conf.pacnew" "$result"
_assert_contains "archup pending config: reports .pacsave files" \
  "/etc/removed.conf.pacsave" "$result"
_assert_contains "archup pending config: indents every pending path" \
  "  /etc/removed.conf.pacsave" "$result"

_archup_mock_reset
result=$(report_pending_pacman_configs 2>&1)
_assert_contains "archup pending config: clean scan reports an all-clear" \
  "ok: no config files awaiting a manual merge" "$result"

_archup_mock_reset
ARCHUP_PACDIFF_STATUS=8
set +e
result=$(report_pending_pacman_configs 2>&1)
status=$?
set -e
_assert_eq "archup pending config: failed scan remains advisory" "0" "$status"
_assert_contains "archup pending config: failed scan is reported as unverified" \
  "could not scan for config files awaiting a manual merge" "$result"
_assert_not_contains "archup pending config: failed scan never claims an all-clear" \
  "ok: no config files" "$result"

_archup_mock_reset
ARCHUP_HAS_PACDIFF=0
result=$(report_pending_pacman_configs 2>&1)
_assert_contains "archup pending config: missing pacdiff is actionable" \
  "install pacman-contrib" "$result"
_assert_not_contains "archup pending config: missing pacdiff never claims an all-clear" \
  "ok: no config files" "$result"

echo ""
echo "=== archup: missing-library scan failures ==="

_archup_mock_reset
_archup_mock_add_package unlisted-package 1 ok
ARCHUP_PACMAN_FILES_STATUS=7
set +e
result=$(scan_missing_libs 2>&1)
status=$?
set -e
_assert_eq "archup scan: package-file listing failure fails the check" "1" "$status"
_assert_contains "archup scan: package-file listing failure is actionable" \
  "could not list files owned by unlisted-package" "$result"
_assert_not_contains "archup scan: package-file listing failure never claims an all-clear" \
  "ok: no missing shared libraries" "$result"

_archup_mock_reset
_archup_mock_add_package unreadable-binary 1 ok
ARCHUP_FILE_STATUS=6
set +e
result=$(scan_missing_libs 2>&1)
status=$?
set -e
_assert_eq "archup scan: file inspection failure fails the check" "1" "$status"
_assert_contains "archup scan: file inspection failure is actionable" \
  "could not identify" "$result"
_assert_not_contains "archup scan: file inspection failure never claims an all-clear" \
  "ok: no missing shared libraries" "$result"

_archup_mock_reset
_archup_mock_add_package unloadable-binary 1 ok
ARCHUP_LDD_STATUS=5
set +e
result=$(scan_missing_libs 2>&1)
status=$?
set -e
_assert_eq "archup scan: ldd failure fails the check" "1" "$status"
_assert_contains "archup scan: ldd failure is actionable" \
  "could not inspect shared-library dependencies" "$result"
_assert_not_contains "archup scan: ldd failure never claims an all-clear" \
  "ok: no missing shared libraries" "$result"

_archup_mock_reset
ARCHUP_PACMAN_FOREIGN_STATUS=4
set +e
result=$(scan_missing_libs 2>&1)
status=$?
set -e
_assert_eq "archup scan: foreign-package query failure fails the check" "1" "$status"
_assert_contains "archup scan: foreign-package query failure is actionable" \
  "could not list foreign packages" "$result"
_assert_not_contains "archup scan: foreign-package query failure never claims an all-clear" \
  "ok: no missing shared libraries" "$result"

echo ""
echo "=== archup: AUR lookup failures ==="

_archup_mock_reset
_archup_mock_add_package local-only 0 ok
result=$(warn_non_aur_foreign_packages 2>&1)
_assert_contains "archup AUR lookup: confirmed absence remains visible" \
  "foreign packages not found in AUR" "$result"
_assert_not_contains "archup AUR lookup: confirmed absence is not called unverified" \
  "could not verify" "$result"

_archup_mock_reset
_archup_mock_add_package lookup-unknown 0 ok
ARCHUP_YAY_AUR_QUERY_STATUS=28
ARCHUP_YAY_AUR_QUERY_ERROR="request failed: AUR is unavailable"
result=$(warn_non_aur_foreign_packages 2>&1)
_assert_contains "archup AUR lookup: outage is reported as unverified" \
  "could not verify AUR membership" "$result"
_assert_not_contains "archup AUR lookup: outage is not reported as package absence" \
  "foreign packages not found in AUR" "$result"

_archup_mock_reset
_archup_mock_add_package broken-lookup-unknown 1 broken
ARCHUP_YAY_AUR_QUERY_STATUS=28
ARCHUP_YAY_AUR_QUERY_ERROR="request failed: AUR is unavailable"
# shellcheck disable=SC2119 # The sysup driver passes upgrade args; this call has none.
result=$(sysup_backend_upgrade 2>&1)
_assert_contains "archup AUR rebuild: outage says the rebuild decision is unverified" \
  "could not verify whether broken-lookup-unknown can be rebuilt from AUR" "$result"
_assert_not_contains "archup AUR rebuild: outage is not reported as package absence" \
  "broken foreign packages are not available in AUR" "$result"

echo ""
echo "=== archup: upgraded service restarts ==="

before_packages=$(_tmpfile)
after_packages=$(_tmpfile)
cat >"$before_packages" <<'EOF'
same-version 1.0
upgraded-service 1.0
EOF
cat >"$after_packages" <<'EOF'
new-package 1.0
same-version 1.0
upgraded-service 2.0
EOF
changed=$(sysup_changed_packages "$before_packages" "$after_packages")
_assert_eq "archup package diff: reports version changes only" \
  "upgraded-service" "$changed"
rm -f "$before_packages" "$after_packages"

_archup_mock_reset
_archup_mock_add_package upgraded-service 1 ok
_archup_mock_add_service upgraded-service upgraded.service
ARCHUP_ACTIVE_UNITS=(upgraded.service unrelated.service)
set +e
result=$(sysup_restart_upgraded_services upgraded-service 2>&1)
status=$?
set -e
systemctl_commands=$(cat "$ARCHUP_SYSTEMCTL_LOG")
_assert_eq "archup restart: a later unrelated unit does not fail service discovery" \
  "0" "$status"
_assert_contains "archup restart: reloads systemd before service restart" \
  "daemon-reload" "$systemctl_commands"
_assert_contains "archup restart: restarts active service from upgraded package" \
  "try-restart upgraded.service" "$systemctl_commands"
_assert_not_contains "archup restart: ignores a later unrelated active unit" \
  "unrelated.service" "$systemctl_commands"
_assert_contains "archup restart: reports upgraded service restart" \
