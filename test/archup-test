  "try-restart" "$systemctl_commands"
_assert_contains "archup restart: reports no active upgraded services" \
  "no active services shipped by upgraded packages" "$result"

_archup_mock_reset
_archup_mock_add_package eternalterminal-server 1 ok 1.0
_archup_mock_add_service eternalterminal-server et.service
ARCHUP_PACKAGE_UPGRADE_VERSIONS["eternalterminal-server"]="2.0"
ARCHUP_ACTIVE_UNITS=(et.service)
sysup_main >/dev/null
