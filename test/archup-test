_archup_mock_add_package broken-lookup-unknown 1 broken
ARCHUP_YAY_AUR_QUERY_STATUS=28
ARCHUP_YAY_AUR_QUERY_ERROR="request failed: AUR is unavailable"
# shellcheck disable=SC2119 # The sysup driver passes upgrade args; this call has none.
