status=$?
set -e
_assert_eq "archup restart: package-file query failure fails service discovery" "1" "$status"
_assert_contains "archup restart: package-file query failure says restarts are incomplete" \
  "could not fully determine active services" "$result"
_assert_not_contains "archup restart: package-file query failure never claims no services exist" \
  "ok: no active services" "$result"

_archup_mock_reset
_archup_mock_add_package unreachable-systemd-service 1 ok
_archup_mock_add_service unreachable-systemd-service unreachable.service
ARCHUP_SYSTEMCTL_ACTIVE_QUERY_STATUS=9
set +e
result=$(sysup_restart_upgraded_services unreachable-systemd-service 2>&1)
status=$?
set -e
_assert_eq "archup restart: unreachable systemd fails service discovery" "1" "$status"
_assert_contains "archup restart: unreachable systemd says restarts are unverified" \
  "could not fully determine active services" "$result"
_assert_not_contains "archup restart: unreachable systemd never claims no services exist" \
  "ok: no active services" "$result"

_archup_mock_reset
_archup_mock_add_package templated-service 1 ok
_archup_mock_add_service templated-service worker@.service
ARCHUP_ACTIVE_UNITS=(worker@alpha.service unrelated.service)
