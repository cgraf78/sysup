yay_commands=$(cat "$ARCHUP_YAY_COMMAND_LOG")
_assert_contains "archup main: package installation is noninteractive by default" \
  "-Syu --devel --noconfirm" "$yay_commands"
_assert_contains "archup main: restarts upgraded services by default" \
  "try-restart et.service" "$systemctl_commands"

_archup_mock_reset
_archup_mock_add_package prompted-main 1 ok
sysup_main -- --confirm >/dev/null
yay_commands=$(cat "$ARCHUP_YAY_COMMAND_LOG")
_assert_contains "archup main: passes --confirm after -- to the backend" \
  "-Syu --devel --confirm" "$yay_commands"
_assert_not_contains "archup main: --confirm removes unattended mode" \
  "--noconfirm" "$yay_commands"

_archup_mock_reset
_archup_mock_add_package optout-service 1 ok 1.0
_archup_mock_add_service optout-service optout.service
ARCHUP_PACKAGE_UPGRADE_VERSIONS["optout-service"]="2.0"
ARCHUP_ACTIVE_UNITS=(optout.service)
sysup_main --no-restart-upgraded-services >/dev/null
