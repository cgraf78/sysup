# ls, not GNU stat: the suites also run on BSD userlands.
_path_mode() {
  local mode
  mode=$(ls -ld -- "$1")
  printf '%s\n' "${mode:0:10}"
}

# The deferring run records the unit with the boot and the unit's own
# activation time, creating the root-owned state directory on first use.
_archup_mock_reset
_archup_mock_add_package reminder-session 1 ok
_archup_mock_add_service reminder-session user@.service
ARCHUP_ACTIVE_UNITS=(user@1000.service)
sysup_restart_upgraded_services reminder-session >/dev/null 2>&1
_assert_eq "archup reminder: records the deferred unit for this boot" \
  $'boot-a\tuser@1000.service\t100' "$(grep -v '^#' "$ARCHUP_STATE_FILE")"
_assert_eq "archup reminder: state file is world-readable, not writable" \
  "-rw-r--r--" "$(_path_mode "$ARCHUP_STATE_FILE")"
_assert_eq "archup reminder: state directory is created traversable" \
  "drwxr-xr-x" "$(_path_mode "$SYSUP_STATE_DIR")"

# Later runs keep reminding with one stable marker line, and a read-only
# (check-only) reminder leaves the state untouched.
state_before=$(cat "$ARCHUP_STATE_FILE")
set +e
result=$(sysup_report_deferred_restarts 0 2>&1 >/dev/null)
status=$?
set -e
_assert_eq "archup reminder: reminding is advisory" "0" "$status"
_assert_eq "archup reminder: later run prints one stable marker on stderr" \
  "reboot recommended: session-critical units may still run pre-upgrade code: user@1000.service; restart them manually or reboot" \
  "$result"
_assert_eq "archup reminder: read-only reminder keeps the state" \
  "$state_before" "$(cat "$ARCHUP_STATE_FILE")"

# A newer boot clears the reminder; only a mutating run prunes the file.
printf 'boot-b\n' >"$SYSUP_BOOT_ID_FILE"
result=$(sysup_report_deferred_restarts 0 2>&1)
_assert_not_contains "archup reminder: newer boot clears the reminder" \
  "reboot recommended" "$result"
_assert_eq "archup reminder: read-only run does not prune after a reboot" \
  present "$(_path_state "$ARCHUP_STATE_FILE")"
sysup_report_deferred_restarts 1 >/dev/null 2>&1
_assert_eq "archup reminder: mutating run removes the stale state" \
  absent "$(_path_state "$ARCHUP_STATE_FILE")"

# A manual restart since the deferral clears the unit without a reboot.
_archup_mock_reset
_archup_mock_add_package manual-restart 1 ok
_archup_mock_add_service manual-restart user@.service
_archup_mock_add_service manual-restart gdm.service
ARCHUP_ACTIVE_UNITS=(gdm.service user@1000.service)
sysup_restart_upgraded_services manual-restart >/dev/null 2>&1
ARCHUP_ACTIVE_SINCE[user@1000.service]=250
result=$(sysup_report_deferred_restarts 1 2>&1)
_assert_contains "archup reminder: unrestarted unit is still reported" \
  "pre-upgrade code: gdm.service;" "$result"
_assert_eq "archup reminder: manually restarted unit is pruned" \
  $'boot-a\tgdm.service\t100' "$(grep -v '^#' "$ARCHUP_STATE_FILE")"

# A unit that stopped or no longer exists runs no old code.
ARCHUP_ACTIVE_UNITS=()
result=$(sysup_report_deferred_restarts 1 2>&1)
_assert_not_contains "archup reminder: stopped or removed unit is not reported" \
  "reboot recommended" "$result"
_assert_eq "archup reminder: stopped or removed unit is pruned" \
  absent "$(_path_state "$ARCHUP_STATE_FILE")"

# A later deferral merges with pending ones and refreshes a re-deferred unit.
_archup_mock_reset
_archup_mock_add_package merge-first 1 ok
_archup_mock_add_service merge-first gdm.service
_archup_mock_add_package merge-second 1 ok
_archup_mock_add_service merge-second user@.service
_archup_mock_add_service merge-second gdm.service
ARCHUP_ACTIVE_UNITS=(gdm.service user@1000.service)
sysup_restart_upgraded_services merge-first >/dev/null 2>&1
ARCHUP_ACTIVE_SINCE[gdm.service]=300
sysup_restart_upgraded_services merge-second >/dev/null 2>&1
_assert_eq "archup reminder: merges and refreshes deferred units" \
  $'boot-a\tgdm.service\t300\nboot-a\tuser@1000.service\t100' \
  "$(grep -v '^#' "$ARCHUP_STATE_FILE" | LC_ALL=C sort)"

# Without a readable boot identity the reminder persists until the unit is
# restarted, rather than being dropped as if the host had rebooted.
_archup_mock_reset
_archup_mock_add_package no-boot-id 1 ok
_archup_mock_add_service no-boot-id dbus.service
ARCHUP_ACTIVE_UNITS=(dbus.service)
rm -f "$SYSUP_BOOT_ID_FILE"
sysup_restart_upgraded_services no-boot-id >/dev/null 2>&1
printf 'boot-c\n' >"$SYSUP_BOOT_ID_FILE"
result=$(sysup_report_deferred_restarts 1 2>&1)
_assert_contains "archup reminder: unknown boot identity keeps reminding" \
  "pre-upgrade code: dbus.service;" "$result"

# Malformed lines are ignored rather than reported or passed to systemctl.
_archup_mock_reset
ARCHUP_ACTIVE_UNITS=(gdm.service)
mkdir -p "$SYSUP_STATE_DIR"
printf '%s\n' '# comment' 'garbage' $'boot-a\tgdm.service\t100' $'boot-a\t\t' \
  >"$ARCHUP_STATE_FILE"
result=$(sysup_report_deferred_restarts 0 2>&1)
_assert_eq "archup reminder: malformed lines are ignored" \
  "reboot recommended: session-critical units may still run pre-upgrade code: gdm.service; restart them manually or reboot" \
  "$result"

# Failing to persist is a warning, not a failed run: this run's deferral was
# already reported.
_archup_mock_reset
_archup_mock_add_package unwritable-state 1 ok
_archup_mock_add_service unwritable-state user@.service
ARCHUP_ACTIVE_UNITS=(user@1000.service)
: >"$ARCHUP_MOCK_ROOT/not-a-dir"
SYSUP_STATE_DIR="$ARCHUP_MOCK_ROOT/not-a-dir/state"
set +e
result=$(sysup_restart_upgraded_services unwritable-state 2>&1)
status=$?
set -e
_assert_eq "archup reminder: unwritable state does not fail the restart step" \
  "0" "$status"
_assert_contains "archup reminder: unwritable state is reported" \
  "could not record deferred restarts" "$result"

# Transient states still run the unit's code; only inactive or failed spend
# the entry.
_archup_mock_reset
ARCHUP_ACTIVE_UNITS=(gdm.service)
mkdir -p "$SYSUP_STATE_DIR"
printf '%s\n' $'boot-a\tgdm.service\t100' >"$ARCHUP_STATE_FILE"
ARCHUP_UNIT_STATE[gdm.service]=reloading
result=$(sysup_report_deferred_restarts 1 2>&1)
_assert_contains "archup reminder: reloading unit is still reported" \
  "pre-upgrade code: gdm.service;" "$result"
_assert_eq "archup reminder: reloading unit is not pruned" \
  present "$(_path_state "$ARCHUP_STATE_FILE")"
ARCHUP_UNIT_STATE[gdm.service]=failed
sysup_report_deferred_restarts 1 >/dev/null 2>&1
_assert_eq "archup reminder: failed unit is pruned" \
  absent "$(_path_state "$ARCHUP_STATE_FILE")"

# A unit systemd cannot be asked about keeps its entry.
_archup_mock_reset
ARCHUP_ACTIVE_UNITS=(gdm.service)
mkdir -p "$SYSUP_STATE_DIR"
printf '%s\n' $'boot-a\tgdm.service\t100' >"$ARCHUP_STATE_FILE"
ARCHUP_SYSTEMCTL_SHOW_STATUS=6
result=$(sysup_report_deferred_restarts 1 2>&1)
_assert_contains "archup reminder: unqueryable unit is still reported" \
  "pre-upgrade code: gdm.service;" "$result"
_assert_eq "archup reminder: unqueryable unit is not pruned" \
  present "$(_path_state "$ARCHUP_STATE_FILE")"

# A record without a trailing newline, and duplicate lines, are read once.
_archup_mock_reset
ARCHUP_ACTIVE_UNITS=(gdm.service sddm.service)
mkdir -p "$SYSUP_STATE_DIR"
printf '%s\n%s\n%s' $'boot-a\tsddm.service\t100' $'boot-a\tsddm.service\t100' \
  $'boot-a\tgdm.service\t100' >"$ARCHUP_STATE_FILE"
result=$(sysup_report_deferred_restarts 0 2>&1)
_assert_contains "archup reminder: reads a last line without a newline, once per unit" \
  "pre-upgrade code: sddm.service gdm.service;" "$result"

# Without systemctl there is nothing to check, so the reminder is a no-op.
_archup_mock_reset
mkdir -p "$SYSUP_STATE_DIR"
printf '%s\n' $'boot-a\tgdm.service\t100' >"$ARCHUP_STATE_FILE"
result=$(
  unset -f systemctl
  # shellcheck disable=SC2123 # Deliberately hide any host systemctl.
  PATH=/nonexistent
  sysup_report_deferred_restarts 1 2>&1
)
_assert_eq "archup reminder: no systemctl means no reminder" "" "$result"
_assert_eq "archup reminder: no systemctl leaves the record" \
  present "$(_path_state "$ARCHUP_STATE_FILE")"

# user-runtime-dir@ has no running code, so it is deferred but not recorded.
_archup_mock_reset
_archup_mock_add_package runtime-dir 1 ok
_archup_mock_add_service runtime-dir user-runtime-dir@.service
ARCHUP_ACTIVE_UNITS=(user-runtime-dir@1000.service)
result=$(sysup_restart_upgraded_services runtime-dir 2>&1)
_assert_contains "archup reminder: user-runtime-dir@ is still deferred" \
  "units not restarted: user-runtime-dir@1000.service" "$result"
_assert_eq "archup reminder: user-runtime-dir@ is not recorded" \
  absent "$(_path_state "$ARCHUP_STATE_FILE")"

# An existing record that cannot be read is never overwritten.
if ((EUID != 0)); then
  _archup_mock_reset
  _archup_mock_add_package unreadable-record 1 ok
  _archup_mock_add_service unreadable-record user@.service
  ARCHUP_ACTIVE_UNITS=(user@1000.service)
  mkdir -p "$SYSUP_STATE_DIR"
  printf '%s\n' $'boot-a\tgdm.service\t100' >"$ARCHUP_STATE_FILE"
  chmod 000 "$ARCHUP_STATE_FILE"
  result=$(sysup_restart_upgraded_services unreadable-record 2>&1)
  chmod 644 "$ARCHUP_STATE_FILE"
  _assert_contains "archup reminder: unreadable record is reported" \
    "could not read $ARCHUP_STATE_FILE" "$result"
  _assert_eq "archup reminder: unreadable record is left intact" \
    $'boot-a\tgdm.service\t100' "$(cat "$ARCHUP_STATE_FILE")"
fi

# The driver reminds on every run, including --check-only, without pruning.
_archup_mock_reset
ARCHUP_ACTIVE_UNITS=(sddm.service)
mkdir -p "$SYSUP_STATE_DIR"
printf '%s\n' $'boot-a\tsddm.service\t100' >"$ARCHUP_STATE_FILE"
set +e
result=$(sysup_main --check-only 2>&1)
status=$?
set -e
_assert_eq "archup main: pending reminder keeps a clean check-only run successful" \
  "0" "$status"
_assert_contains "archup main: check-only run repeats the reminder" \
  "reboot recommended: session-critical units may still run pre-upgrade code: sddm.service;" \
  "$result"
printf 'boot-b\n' >"$SYSUP_BOOT_ID_FILE"
: >"$ARCHUP_SUDO_COMMAND_LOG"
sysup_main --check-only >/dev/null 2>&1 || true
_assert_eq "archup main: check-only run never prunes the state" \
  present "$(_path_state "$ARCHUP_STATE_FILE")"
_assert_eq "archup main: check-only run issues no privileged state writes" \
  "" "$(grep -E '^(install|mv|rm) ' "$ARCHUP_SUDO_COMMAND_LOG" || true)"
sysup_main --no-restart-upgraded-services >/dev/null 2>&1 || true
_assert_eq "archup main: a no-restart upgrade run still prunes a spent record" \
  absent "$(_path_state "$ARCHUP_STATE_FILE")"
mkdir -p "$SYSUP_STATE_DIR"
printf '%s\n' $'boot-a\tsddm.service\t100' >"$ARCHUP_STATE_FILE"
sysup_main >/dev/null 2>&1 || true
_assert_eq "archup main: an upgrade run prunes state from an earlier boot" \
  absent "$(_path_state "$ARCHUP_STATE_FILE")"

echo ""
echo "=== archup: failed unit reporting ==="

_archup_mock_reset
ARCHUP_FAILED_UNITS="postgresql.service loaded failed failed PostgreSQL"
set +e
result=$(sysup_report_failed_units 2>&1)
status=$?
set -e
_assert_eq "archup failed units: a failed unit fails the run" "1" "$status"
_assert_contains "archup failed units: names the failed unit" \
  "postgresql.service" "$result"
# Backends are private and not on PATH, so the hint must name the public
# dispatcher that forwards --restart-failed to them.
_assert_contains "archup failed units: hint names the public sysup command" \
  "sysup --restart-failed" "$result"

# An unverifiable unit state must never be reported as healthy: that is the
# exact claim this tool exists to make.
_archup_mock_reset
ARCHUP_SYSTEMCTL_QUERY_STATUS=1
set +e
result=$(sysup_report_failed_units 2>&1)
status=$?
set -e
_assert_eq "archup failed units: an unreachable systemd fails the run" "1" "$status"
_assert_contains "archup failed units: says the state is unverified" \
  "unverified" "$result"
_assert_not_contains "archup failed units: never claims health it did not verify" \
  "ok: no failed systemd units" "$result"

_archup_mock_reset
ARCHUP_FAILED_UNITS="broken.service loaded failed failed Broken"
sysup_restart_failed_units >/dev/null 2>&1
systemctl_commands=$(cat "$ARCHUP_SYSTEMCTL_LOG")
_assert_contains "archup restart-failed: clears the failed state first" \
  "reset-failed broken.service" "$systemctl_commands"
_assert_contains "archup restart-failed: restarts the failed enabled unit" \
  "restart broken.service" "$systemctl_commands"

# A disabled unit failed on a manual or dependency-triggered start. Restarting it
# here would start a service the host is deliberately not running.
_archup_mock_reset
ARCHUP_FAILED_UNITS="offbydesign.service loaded failed failed Off"
ARCHUP_DISABLED_UNITS="offbydesign.service"
result=$(sysup_restart_failed_units 2>&1)
systemctl_commands=$(cat "$ARCHUP_SYSTEMCTL_LOG")
_assert_not_contains "archup restart-failed: leaves disabled failed units alone" \
  "restart offbydesign.service" "$systemctl_commands"
_assert_contains "archup restart-failed: says why it restarted nothing" \
  "no failed enabled units to restart" "$result"

echo ""
echo "=== archup: separated debug info ==="

# Regression: /usr/lib/debug/**/*.debug reports itself as dynamically linked but
# is never loaded, so ldd rejects it. Treating that as an unverified scan failed
