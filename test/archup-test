#!/usr/bin/env bash
# archup-test - unit tests for the Arch upgrade helper.

set -o pipefail
export NO_COLOR=1

TEST_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd "$TEST_DIR/.." && pwd)
# shellcheck source=lib/test.sh
. "$TEST_DIR/lib/test.sh"

export SYSUP_SOURCE_ONLY=1
# shellcheck source=../lib/sysup/archup
. "$REPO_ROOT/lib/sysup/archup"

echo "=== archup: conditional AUR rebuilds ==="

_archup_mock_reset() {
  ARCHUP_MOCK_ROOT=$(_tmpdir)
  ARCHUP_YAY_COMMAND_LOG="$ARCHUP_MOCK_ROOT/yay-commands.log"
  ARCHUP_PACMAN_COMMAND_LOG="$ARCHUP_MOCK_ROOT/pacman-commands.log"
  : >"$ARCHUP_YAY_COMMAND_LOG"
  : >"$ARCHUP_PACMAN_COMMAND_LOG"
  ARCHUP_PACKAGES=()
  declare -gA ARCHUP_PACKAGE_FILES=()
  declare -gA ARCHUP_PACKAGE_VERSIONS=()
  declare -gA ARCHUP_PACKAGE_UPGRADE_VERSIONS=()
  declare -gA ARCHUP_AUR_PACKAGES=()
  declare -gA ARCHUP_LDD_OUTPUT=()
  ARCHUP_LDD_REJECTED_FILES=""
  ARCHUP_ACTIVE_UNITS=()
  ARCHUP_FAILED_UNITS=""
  ARCHUP_DISABLED_UNITS=""
  ARCHUP_SYSTEMCTL_QUERY_STATUS=0
  ARCHUP_SYSTEMCTL_ACTIVE_QUERY_STATUS=0
  ARCHUP_YAY_FAIL_UPGRADE=0
  ARCHUP_YAY_FAIL_REBUILD=0
  ARCHUP_YAY_AUR_QUERY_STATUS=0
  ARCHUP_YAY_AUR_QUERY_ERROR=""
  ARCHUP_HAS_YAY=1
  ARCHUP_PACMAN_FOREIGN_STATUS=0
  ARCHUP_PACMAN_FILES_STATUS=0
  ARCHUP_FILE_STATUS=0
  ARCHUP_LDD_STATUS=0
  ARCHUP_SYSTEMCTL_LOG="$ARCHUP_MOCK_ROOT/systemctl-commands.log"
  : >"$ARCHUP_SYSTEMCTL_LOG"
}

_archup_mock_add_package() {
  local name="$1" aur="$2" libs="$3"
  local version="${4:-1.0}"
  local file="$ARCHUP_MOCK_ROOT/$name/bin/$name"

  mkdir -p "$(dirname "$file")"
  : >"$file"
  ARCHUP_PACKAGES+=("$name")
  ARCHUP_PACKAGE_FILES["$name"]="$file"
  ARCHUP_PACKAGE_VERSIONS["$name"]="$version"
  ARCHUP_AUR_PACKAGES["$name"]="$aur"
  case "$libs" in
    broken)
      ARCHUP_LDD_OUTPUT["$file"]=$'libmissing.so => not found\nlibok.so => /usr/lib/libok.so'
      ;;
    ok)
      ARCHUP_LDD_OUTPUT["$file"]=$'libok.so => /usr/lib/libok.so'
      ;;
    *)
      echo "unknown mock lib state: $libs" >&2
      return 2
      ;;
  esac
}

_archup_mock_add_debug_file() {
  local pkg="$1"
  local file="$ARCHUP_MOCK_ROOT/$pkg/debug/$pkg.debug"

  mkdir -p "$(dirname "$file")"
  : >"$file"
  ARCHUP_PACKAGE_FILES["$pkg"]+=$'\n'"$file"
  ARCHUP_LDD_REJECTED_FILES+=" $file"
}

_archup_mock_add_service() {
  local pkg="$1" unit="$2"
  ARCHUP_PACKAGE_FILES["$pkg"]+=$'\n'"/usr/lib/systemd/system/$unit"
}

pacman() {
  case "$1" in
    -Q)
      local pkg
      for pkg in "${ARCHUP_PACKAGES[@]}"; do
        printf '%s %s\n' "$pkg" "${ARCHUP_PACKAGE_VERSIONS[$pkg]}"
      done
      ;;
    -Qqm)
      if ((ARCHUP_PACMAN_FOREIGN_STATUS != 0)); then
        printf 'mock pacman foreign-package query failed\n' >&2
        return "$ARCHUP_PACMAN_FOREIGN_STATUS"
      fi
      printf '%s\n' "${ARCHUP_PACKAGES[@]}"
      ;;
    -Qlq)
      if ((ARCHUP_PACMAN_FILES_STATUS != 0)); then
        printf 'mock pacman file listing failed for %s\n' "$2" >&2
        return "$ARCHUP_PACMAN_FILES_STATUS"
      fi
      printf '%s\n' "${ARCHUP_PACKAGE_FILES[$2]:-}"
      ;;
    -Syu)
      printf '%s\n' "$*" >>"$ARCHUP_PACMAN_COMMAND_LOG"
      ;;
    *)
      echo "unexpected pacman args: $*" >&2
      return 2
      ;;
  esac
}

# Let the fallback test hide the yay function without changing PATH or the
# command lookup behavior used by the rest of the suite.
command() {
  if [[ "${1:-}" == "-v" && "${2:-}" == yay ]]; then
    ((ARCHUP_HAS_YAY != 0)) || return 1
    printf 'yay\n'
    return 0
  fi

  builtin command "$@"
}

yay() {
  if [[ "$1" == "-Si" && "$2" == "--aur" ]]; then
    if ((ARCHUP_YAY_AUR_QUERY_STATUS != 0)); then
      printf '%s\n' "$ARCHUP_YAY_AUR_QUERY_ERROR" >&2
      printf ' -> No AUR package found for %s\n' "$3" >&2
      return "$ARCHUP_YAY_AUR_QUERY_STATUS"
    fi
    if [[ "${ARCHUP_AUR_PACKAGES[$3]:-0}" == 1 ]]; then
      return 0
    fi
    printf ' -> No AUR package found for %s\n' "$3" >&2
    return 1
  fi

  if [[ "$1" == "-Syu" ]]; then
    if ((ARCHUP_YAY_FAIL_UPGRADE != 0)); then
      return "$ARCHUP_YAY_FAIL_UPGRADE"
    fi

    local pkg
    for pkg in "${!ARCHUP_PACKAGE_UPGRADE_VERSIONS[@]}"; do
      ARCHUP_PACKAGE_VERSIONS["$pkg"]="${ARCHUP_PACKAGE_UPGRADE_VERSIONS[$pkg]}"
    done
  fi

  if [[ "$1" == "-S" && "$2" == "--aur" ]] && ((ARCHUP_YAY_FAIL_REBUILD != 0)); then
    return "$ARCHUP_YAY_FAIL_REBUILD"
  fi

  printf '%s\n' "$*" >>"$ARCHUP_YAY_COMMAND_LOG"
}

file() {
  if ((ARCHUP_FILE_STATUS != 0)); then
    printf 'mock file inspection failed for %s\n' "${2:-}" >&2
    return "$ARCHUP_FILE_STATUS"
  fi
  if [[ "$1" == *.service ]]; then
    printf 'ASCII text\n'
    return
  fi
  printf 'ELF 64-bit LSB pie executable, dynamically linked\n'
}

ldd() {
  if ((ARCHUP_LDD_STATUS != 0)); then
    printf 'mock ldd inspection failed for %s\n' "$1" >&2
    return "$ARCHUP_LDD_STATUS"
  fi
  if [[ " $ARCHUP_LDD_REJECTED_FILES " == *" $1 "* ]]; then
    printf '\tnot a dynamic executable\n' >&2
    return 1
  fi
  printf '%s\n' "${ARCHUP_LDD_OUTPUT[$1]:-}"
}

sudo() {
  if [[ "${1:-}" == "-v" ]]; then
    return 0
  fi

  "$@"
}

systemctl() {
  case "$1" in
    list-units)
      if ((ARCHUP_SYSTEMCTL_ACTIVE_QUERY_STATUS != 0)); then
        printf 'Failed to connect to bus: Connection refused\n' >&2
        return "$ARCHUP_SYSTEMCTL_ACTIVE_QUERY_STATUS"
      fi
      local unit
      for unit in "${ARCHUP_ACTIVE_UNITS[@]}"; do
        printf '%s loaded active running mock unit\n' "$unit"
      done
      ;;
    daemon-reload | try-restart | reset-failed | restart)
      printf '%s\n' "$*" >>"$ARCHUP_SYSTEMCTL_LOG"
      ;;
    --failed)
      ((ARCHUP_SYSTEMCTL_QUERY_STATUS == 0)) || {
        printf 'Failed to connect to bus: Connection refused\n' >&2
        return "$ARCHUP_SYSTEMCTL_QUERY_STATUS"
      }
      [[ -z "$ARCHUP_FAILED_UNITS" ]] || printf '%s\n' "$ARCHUP_FAILED_UNITS"
      ;;
    is-enabled)
      # $2 is the unit; the fixture lists the ones that are not enabled.
      if [[ " $ARCHUP_DISABLED_UNITS " == *" $2 "* ]]; then
        printf 'disabled\n'
      else
        printf 'enabled\n'
      fi
      ;;
    *)
      printf 'unexpected systemctl args: %s\n' "$*" >&2
      return 2
      ;;
  esac
}

sysup_require_family() {
  return 0
}

_archup_mock_reset
_archup_mock_add_package eternalterminal-server 1 ok
# shellcheck disable=SC2119 # The sysup driver passes upgrade args; this call has none.
result=$(sysup_backend_upgrade 2>&1)
