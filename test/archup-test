_archup_mock_reset
_archup_mock_add_package debugged-pkg 1 ok
_archup_mock_add_debug_file debugged-pkg
set +e
result=$(scan_missing_libs 2>&1)
status=$?
set -e
_assert_eq "archup debug info: a .debug file does not fail the library scan" \
  "0" "$status"
_assert_contains "archup debug info: the scan still reports a clean result" \
  "no missing shared libraries" "$result"
_assert_not_contains "archup debug info: does not claim the state is unverified" \
  "unverified" "$result"

# The hardening this preserves: a genuine ldd failure on a loadable object must
# still fail the scan rather than being skipped.
_archup_mock_reset
_archup_mock_add_package normal-pkg 1 ok
ARCHUP_LDD_STATUS=1
set +e
result=$(scan_missing_libs 2>&1)
status=$?
set -e
ARCHUP_LDD_STATUS=0
_assert_eq "archup debug info: a real ldd failure still fails the scan" \
  "1" "$status"
_assert_contains "archup debug info: a real ldd failure is reported as unverified" \
  "unverified" "$result"

echo ""
echo "=== archup: empty upgrade set ==="

# Regression: with nothing to upgrade both package sets are empty, and
# sysup_unique_packages returned 1 under `set -o pipefail` because its filter
