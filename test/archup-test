_assert_not_contains "archup scan: package-file listing failure never claims an all-clear" \
  "ok: no missing shared libraries" "$result"

_archup_mock_reset
_archup_mock_add_package unreadable-binary 1 ok
ARCHUP_FILE_STATUS=6
set +e
result=$(scan_missing_libs 2>&1)
status=$?
set -e
_assert_eq "archup scan: file inspection failure fails the check" "1" "$status"
_assert_contains "archup scan: file inspection failure is actionable" \
