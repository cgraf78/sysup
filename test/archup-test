unique_status=$?
set -e
_assert_eq "archup unique packages: no arguments is a success" "0" "$unique_status"
_assert_eq "archup unique packages: no arguments prints nothing" "" "$unique_result"

set +e
unique_result=$(sysup_unique_packages "" "")
unique_status=$?
set -e
_assert_eq "archup unique packages: only empty arguments is a success" \
  "0" "$unique_status"
_assert_eq "archup unique packages: only empty arguments prints nothing" \
  "" "$unique_result"

set +e
unique_result=$(sysup_unique_packages zsh bash zsh "")
unique_status=$?
set -e
_assert_eq "archup unique packages: real arguments succeed" "0" "$unique_status"
_assert_eq "archup unique packages: deduplicates and sorts" \
  $'bash\nzsh' "$unique_result"

_archup_mock_reset
_archup_mock_add_package steady-pkg 1 ok 1.0
