set +e
result=$(sysup_report_failed_units 2>&1)
status=$?
set -e
_assert_eq "archup failed units: a failed unit fails the run" "1" "$status"
_assert_contains "archup failed units: names the failed unit" \
  "postgresql.service" "$result"
