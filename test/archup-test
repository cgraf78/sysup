_assert_contains "archup restart: restarts active service from upgraded package" \
  "try-restart upgraded.service" "$systemctl_commands"
_assert_not_contains "archup restart: ignores a later unrelated active unit" \
  "unrelated.service" "$systemctl_commands"
_assert_contains "archup restart: reports upgraded service restart" \
  "restarting active services from upgraded packages" "$result"
_assert_not_contains "archup restart: a later unrelated unit is not unverified" \
  "could not fully determine active services" "$result"

_archup_mock_reset
_archup_mock_add_package unlistable-service 1 ok
_archup_mock_add_service unlistable-service unlistable.service
ARCHUP_ACTIVE_UNITS=(unlistable.service)
ARCHUP_PACMAN_FILES_STATUS=7
set +e
