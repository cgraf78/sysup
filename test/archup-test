echo ""
echo "=== archup: missing-library scan failures ==="

_archup_mock_reset
_archup_mock_add_package unlisted-package 1 ok
ARCHUP_PACMAN_FILES_STATUS=7
set +e
result=$(scan_missing_libs 2>&1)
status=$?
set -e
_assert_eq "archup scan: package-file listing failure fails the check" "1" "$status"
_assert_contains "archup scan: package-file listing failure is actionable" \
