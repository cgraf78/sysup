#!/usr/bin/env bash
# sysup-test - unit tests for OS family detection and backend dispatch.
#
# SYSUP_OS_ROOT is reassigned throughout to steer detection at a fixture tree.
# It is read by the sourced detect.sh, never by this file.
# shellcheck disable=SC2034

set -euo pipefail
export NO_COLOR=1

TEST_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd "$TEST_DIR/.." && pwd)
# shellcheck source=lib/test.sh
. "$TEST_DIR/lib/test.sh"

echo "=== test harness safety ==="

# A failed fixture allocation must never collapse to an empty string that a
# caller can extend into a root-level path such as /apt.log. Exercise the
# helper fault paths directly, then separately require every suite to run with
# errexit so an unchecked assignment cannot continue after that failure.
tmpdir_failure_exit=0
tmpdir_failure_output=$(
  # shellcheck disable=SC2329  # resolved indirectly by _tmpdir
  mktemp() { return 1; }
  _tmpdir 2>&1
) || tmpdir_failure_exit=$?
_assert_eq "test harness: directory allocation failure is fatal" \
  "1" "$tmpdir_failure_exit"
_assert_contains "test harness: directory allocation failure is actionable" \
  "could not create suite temporary directory" "$tmpdir_failure_output"

tmpfile_failure_exit=0
tmpfile_failure_output=$(
  # shellcheck disable=SC2329  # resolved indirectly by _tmpfile
  mktemp() { return 1; }
  _tmpfile 2>&1
) || tmpfile_failure_exit=$?
_assert_eq "test harness: file allocation failure is fatal" \
  "1" "$tmpfile_failure_exit"
_assert_contains "test harness: file allocation failure is actionable" \
  "could not create suite temporary file" "$tmpfile_failure_output"

unchecked_failure_exit=0
unchecked_failure_output=$(
  SYSUP_TEST_LIB="$TEST_DIR/lib/test.sh" bash -euo pipefail -c '
    . "$SYSUP_TEST_LIB"
    mktemp() { return 1; }
    derived="$(_tmpdir)/apt.log"
    printf "continued with %s\n" "$derived"
  ' 2>&1
) || unchecked_failure_exit=$?
_assert_eq "test harness: unchecked allocation aborts the caller" \
  "1" "$unchecked_failure_exit"
_assert_not_contains "test harness: unchecked allocation never derives /apt.log" \
  "continued with /apt.log" "$unchecked_failure_output"

case $- in
  *e*) _pass "test harness: suite exits on an unchecked allocation failure" ;;
  *) _fail "test harness: suite exits on an unchecked allocation failure" ;;
esac

echo ""
echo "=== sysup: CI compatibility gates ==="

SYSUP_REQUIRED_JOB=$(
  awk '
    /^  required:$/ { active = 1; next }
    active && /^  [[:alnum:]_-]+:$/ { exit }
    active { print }
  ' "$REPO_ROOT/.github/workflows/test.yml"
)
_assert_contains "sysup CI: publishes a stable Required check" \
  "name: Required" "$SYSUP_REQUIRED_JOB"
_assert_contains "sysup CI: Required still reports prerequisite failures" \
  "if: \${{ always() }}" "$SYSUP_REQUIRED_JOB"
_assert_contains "sysup CI: Required gates shared platforms and Bash 3.2" \
  "needs: [shell, macos-bash32]" "$SYSUP_REQUIRED_JOB"
_assert_contains "sysup CI: Required reads the shared-platform result" \
  "SHELL_RESULT: \${{ needs.shell.result }}" "$SYSUP_REQUIRED_JOB"
_assert_contains "sysup CI: Required reads the Bash 3.2 result" \
  "BASH32_RESULT: \${{ needs.macos-bash32.result }}" "$SYSUP_REQUIRED_JOB"
_assert_contains "sysup CI: Required enforces shared-platform success" \
  "test \"\$SHELL_RESULT\" = success" "$SYSUP_REQUIRED_JOB"
_assert_contains "sysup CI: Required enforces Bash 3.2 success" \
  "test \"\$BASH32_RESULT\" = success" "$SYSUP_REQUIRED_JOB"

SYSUP_MOCK_BIN=$(_mock_bin)
export PATH="$SYSUP_MOCK_BIN:$PATH"

# Detection is Linux-only by design. Pin uname so the suite asserts the same
# behavior whether it runs on Linux or macOS.
cat >"$SYSUP_MOCK_BIN/uname" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "${SYSUP_TEST_KERNEL:-Linux}"
EOF
chmod +x "$SYSUP_MOCK_BIN/uname"

# shellcheck source=../lib/sysup/detect.sh
. "$REPO_ROOT/lib/sysup/detect.sh"

# Build a fixture root holding the OS identification files detection reads.
_sysup_os_root() {
  local root
  root=$(_tmpdir)
  mkdir -p "$root/etc"
  printf '%s\n' "$root"
}

_sysup_write_os_release() {
  local root="$1"
  shift
  printf '%s\n' "$@" >"$root/etc/os-release"
}

echo "=== sysup: OS family detection ==="

os_root=$(_sysup_os_root)
_sysup_write_os_release "$os_root" 'ID=arch'
SYSUP_OS_ROOT="$os_root"
_assert_eq "sysup detect: Arch by ID" "arch" "$(sysup_os_family)"

os_root=$(_sysup_os_root)
_sysup_write_os_release "$os_root" 'ID=debian' 'VERSION_ID="13"'
SYSUP_OS_ROOT="$os_root"
_assert_eq "sysup detect: Debian by ID" "debian" "$(sysup_os_family)"

os_root=$(_sysup_os_root)
_sysup_write_os_release "$os_root" 'ID=ubuntu' 'ID_LIKE=debian'
SYSUP_OS_ROOT="$os_root"
_assert_eq "sysup detect: Ubuntu by ID" "debian" "$(sysup_os_family)"

os_root=$(_sysup_os_root)
_sysup_write_os_release "$os_root" 'ID=endeavouros' 'ID_LIKE=arch'
SYSUP_OS_ROOT="$os_root"
_assert_eq "sysup detect: Arch derivative by ID_LIKE" "arch" "$(sysup_os_family)"

os_root=$(_sysup_os_root)
_sysup_write_os_release "$os_root" 'ID=linuxmint' 'ID_LIKE="ubuntu debian"'
SYSUP_OS_ROOT="$os_root"
_assert_eq "sysup detect: multi-token ID_LIKE resolves to Debian" \
  "debian" "$(sysup_os_family)"

# An unhelpful os-release must not defeat detection when the family marker file
# is present.
os_root=$(_sysup_os_root)
_sysup_write_os_release "$os_root" 'ID=homegrown'
: >"$os_root/etc/debian_version"
SYSUP_OS_ROOT="$os_root"
_assert_eq "sysup detect: falls back to /etc/debian_version" \
  "debian" "$(sysup_os_family)"

os_root=$(_sysup_os_root)
_sysup_write_os_release "$os_root" 'ID=homegrown'
: >"$os_root/etc/arch-release"
SYSUP_OS_ROOT="$os_root"
_assert_eq "sysup detect: falls back to /etc/arch-release" \
  "arch" "$(sysup_os_family)"

os_root=$(_sysup_os_root)
_sysup_write_os_release "$os_root" 'ID=fedora' 'ID_LIKE=rhel'
SYSUP_OS_ROOT="$os_root"
set +e
result=$(sysup_os_family)
status=$?
set -e
_assert_eq "sysup detect: unsupported family fails" "1" "$status"
_assert_eq "sysup detect: unsupported family prints nothing" "" "$result"

os_root=$(_sysup_os_root)
_sysup_write_os_release "$os_root" 'ID=arch'
SYSUP_OS_ROOT="$os_root"
export SYSUP_TEST_KERNEL=Darwin
set +e
sysup_os_family >/dev/null
status=$?
set -e
export SYSUP_TEST_KERNEL=Linux
_assert_eq "sysup detect: non-Linux kernel is unsupported" "1" "$status"

os_root=$(_sysup_os_root)
_sysup_write_os_release "$os_root" 'ID=fedora' 'ID_LIKE=rhel'
SYSUP_OS_ROOT="$os_root"
_assert_eq "sysup detect: describes the host for error messages" \
  "ID=fedora ID_LIKE=rhel" "$(sysup_os_description)"

# A host with no os-release at all still has to produce a readable message.
os_root=$(_sysup_os_root)
SYSUP_OS_ROOT="$os_root"
_assert_eq "sysup detect: missing os-release still describes the host" \
  "ID=unknown ID_LIKE=unknown" "$(sysup_os_description)"

# Sourcing os-release must not leak its assignments into the caller.
os_root=$(_sysup_os_root)
_sysup_write_os_release "$os_root" 'ID=debian' 'NAME="Debian GNU/Linux"'
SYSUP_OS_ROOT="$os_root"
sysup_os_family >/dev/null
_assert_eq "sysup detect: os-release assignments do not leak into the caller" \
  "" "${ID:-}${NAME:-}"

_assert_eq "sysup detect: supported families are reported for errors" \
  "arch,debian" "$(sysup_supported_families)"

echo ""
echo "=== sysup: family guard ==="

os_root=$(_sysup_os_root)
_sysup_write_os_release "$os_root" 'ID=debian'
SYSUP_OS_ROOT="$os_root"
set +e
result=$(SYSUP_BACKEND_NAME=archup sysup_require_family arch 2>&1)
status=$?
set -e
_assert_eq "sysup guard: wrong family fails before the package manager runs" \
  "1" "$status"
_assert_contains "sysup guard: names the backend that refused" \
  "archup only supports Arch Linux hosts" "$result"
_assert_contains "sysup guard: reports what it detected" "ID=debian" "$result"

os_root=$(_sysup_os_root)
_sysup_write_os_release "$os_root" 'ID=debian'
SYSUP_OS_ROOT="$os_root"
set +e
SYSUP_BACKEND_NAME=debup sysup_require_family debian
status=$?
set -e
_assert_eq "sysup guard: matching family passes" "0" "$status"

echo ""
echo "=== sysup: backend dispatch ==="

# Model shdeps' github:repo shape: only bin/sysup is exposed publicly, through
# a relative symlink, while detection and both private backends stay in the
# provider checkout. Resolving the invoked symlink instead of ~/.local/bin is
# the key compatibility boundary for this extraction.
SYSUP_FIXTURE=$(_tmpdir)
SYSUP_PROVIDER="$SYSUP_FIXTURE/provider"
SYSUP_PUBLIC_BIN="$SYSUP_FIXTURE/public/bin"
mkdir -p "$SYSUP_PROVIDER/bin" "$SYSUP_PROVIDER/lib/sysup" "$SYSUP_PUBLIC_BIN"
cp "$REPO_ROOT/bin/sysup" "$SYSUP_PROVIDER/bin/sysup"
cp "$REPO_ROOT/lib/sysup/detect.sh" "$SYSUP_PROVIDER/lib/sysup/detect.sh"
ln -s ../../provider/bin/sysup "$SYSUP_PUBLIC_BIN/sysup"

SYSUP_DISPATCH_LOG="$SYSUP_FIXTURE/dispatch.log"
for backend in archup debup; do
  cat >"$SYSUP_PROVIDER/lib/sysup/$backend" <<EOF
#!/usr/bin/env bash
{
  printf '$backend'
  if ((\$#)); then
    printf ' <%s>' "\$@"
  fi
  printf '\n'
} >"$SYSUP_DISPATCH_LOG"
EOF
  chmod +x "$SYSUP_PROVIDER/lib/sysup/$backend"
done

_sysup_dispatch() {
  local root="$1"
  shift
  : >"$SYSUP_DISPATCH_LOG"
  SYSUP_OS_ROOT="$root" "$SYSUP_PUBLIC_BIN/sysup" "$@"
}

os_root=$(_sysup_os_root)
_sysup_write_os_release "$os_root" 'ID=arch'
_sysup_dispatch "$os_root" >/dev/null 2>&1
_assert_eq "sysup dispatch: Arch host runs archup" \
  "archup" "$(cat "$SYSUP_DISPATCH_LOG")"

os_root=$(_sysup_os_root)
_sysup_write_os_release "$os_root" 'ID=ubuntu' 'ID_LIKE=debian'
_sysup_dispatch "$os_root" >/dev/null 2>&1
_assert_eq "sysup dispatch: Ubuntu host runs debup" \
  "debup" "$(cat "$SYSUP_DISPATCH_LOG")"

os_root=$(_sysup_os_root)
_sysup_write_os_release "$os_root" 'ID=debian'
_sysup_dispatch "$os_root" --check-only -- --extra >/dev/null 2>&1
_assert_eq "sysup dispatch: forwards every argument to the backend" \
  "debup <--check-only> <--> <--extra>" "$(cat "$SYSUP_DISPATCH_LOG")"

_sysup_dispatch "$os_root" '' 'two words' '*' -- tail >/dev/null 2>&1
_assert_eq "sysup dispatch: preserves empty and shell-sensitive arguments" \
  "debup <> <two words> <*> <--> <tail>" "$(cat "$SYSUP_DISPATCH_LOG")"

os_root=$(_sysup_os_root)
_sysup_write_os_release "$os_root" 'ID=fedora' 'ID_LIKE=rhel'
set +e
result=$(_sysup_dispatch "$os_root" 2>&1)
status=$?
set -e
_assert_eq "sysup dispatch: unsupported host fails" "1" "$status"
_assert_contains "sysup dispatch: names the detected host" "ID=fedora" "$result"
_assert_contains "sysup dispatch: lists the families it supports" \
  "arch,debian" "$result"
_assert_eq "sysup dispatch: unsupported host runs no backend" \
  "" "$(cat "$SYSUP_DISPATCH_LOG")"

# --help has to work on a host sysup cannot upgrade, so it must not be gated
# behind detection.
os_root=$(_sysup_os_root)
_sysup_write_os_release "$os_root" 'ID=fedora' 'ID_LIKE=rhel'
set +e
result=$(_sysup_dispatch "$os_root" --help 2>&1)
status=$?
set -e
_assert_eq "sysup dispatch: --help succeeds on an unsupported host" "0" "$status"
_assert_contains "sysup dispatch: --help explains the dispatch" \
  "Usage: sysup" "$result"

os_root=$(_sysup_os_root)
_sysup_write_os_release "$os_root" 'ID=debian'
result=$(_sysup_dispatch "$os_root" --help 2>&1)
_assert_contains "sysup dispatch: --help still reaches the backend" \
  "Usage: sysup" "$result"
_assert_eq "sysup dispatch: --help forwards to the backend for its flags" \
  "debup <--help>" "$(cat "$SYSUP_DISPATCH_LOG")"

# Restricting PATH to the system directories also picks the system bash, which
# on macOS is 3.2. That is deliberate: the dispatcher has to reach its
# unsupported-host and missing-backend messages under the oldest shell it can
# land on, rather than aborting inside the library it sources.
rm "$SYSUP_PROVIDER/lib/sysup/debup"
os_root=$(_sysup_os_root)
_sysup_write_os_release "$os_root" 'ID=debian'
set +e
result=$(PATH="$SYSUP_MOCK_BIN:/usr/bin:/bin" _sysup_dispatch "$os_root" 2>&1)
status=$?
set -e
_assert_eq "sysup dispatch: missing backend fails" "1" "$status"
_assert_contains "sysup dispatch: missing backend names what to install" \
  "debup backend is not installed" "$result"

# Absolute links are also used when shdeps exposes a configured local checkout.
# Exercise both link forms so the launcher never relies on GNU readlink -f.
SYSUP_ABSOLUTE_BIN=$(_tmpdir)
ln -s "$SYSUP_PROVIDER/bin/sysup" "$SYSUP_ABSOLUTE_BIN/sysup"
os_root=$(_sysup_os_root)
_sysup_write_os_release "$os_root" 'ID=fedora'
set +e
result=$(SYSUP_OS_ROOT="$os_root" "$SYSUP_ABSOLUTE_BIN/sysup" 2>&1)
status=$?
set -e
_assert_eq "sysup dispatch: absolute install symlink loads provider detection" \
  "1" "$status"
_assert_contains "sysup dispatch: absolute install symlink reports the host" \
  "ID=fedora" "$result"

echo ""
echo "=== sysup: installation layout ==="

SYSUP_INSTALLER="$REPO_ROOT/install.sh"
SYSUP_INSTALLER_DELEGATE="$REPO_ROOT/support/install-checkout.sh"

if [[ -f "$SYSUP_INSTALLER" ]]; then
  _pass "sysup install: generated checkout wrapper is present"
else
  _fail "sysup install: generated checkout wrapper is present"
fi
if [[ -f "$SYSUP_INSTALLER_DELEGATE" ]]; then
  _pass "sysup install: checkout-owned delegate is present"
else
  _fail "sysup install: checkout-owned delegate is present"
fi
_assert_eq "sysup install: wrapper identifies the shared generator" \
  "# Generated by cgraf78/actions checkout-installer. Do not edit." \
  "$(sed -n '2p' "$SYSUP_INSTALLER")"

SYSUP_PREFIX=$(_tmpdir)
set +e
PREFIX="$SYSUP_PREFIX" "$SYSUP_INSTALLER" >/dev/null 2>&1
SYSUP_INSTALL_STATUS=$?
set -e
_assert_eq "sysup install: direct checkout succeeds" \
  "0" "$SYSUP_INSTALL_STATUS"
if [[ -x "$SYSUP_PREFIX/bin/sysup" ]]; then
  _pass "sysup install: publishes the dispatcher"
else
  _fail "sysup install: publishes the dispatcher"
fi
if [[ -L "$SYSUP_PREFIX/bin/sysup" ]]; then
  _pass "sysup install: publishes a version-coupled link"
else
  _fail "sysup install: publishes a version-coupled link"
fi
_assert_eq "sysup install: link selects this checkout" \
  "$REPO_ROOT/bin/sysup" "$(readlink "$SYSUP_PREFIX/bin/sysup")"
if [[ ! -e "$SYSUP_PREFIX/lib/sysup" && ! -L "$SYSUP_PREFIX/lib/sysup" ]]; then
  _pass "sysup install: keeps the provider library in its checkout"
else
  _fail "sysup install: keeps the provider library in its checkout"
fi
if [[ ! -e "$SYSUP_PREFIX/bin/archup" && ! -e "$SYSUP_PREFIX/bin/debup" ]]; then
  _pass "sysup install: keeps backends out of the public command directory"
else
  _fail "sysup install: keeps backends out of the public command directory"
fi

SYSUP_DIRECT_OS_ROOT=$(_sysup_os_root)
_sysup_write_os_release "$SYSUP_DIRECT_OS_ROOT" 'ID=fedora'
set +e
direct_dispatch_output=$(SYSUP_OS_ROOT="$SYSUP_DIRECT_OS_ROOT" \
  "$SYSUP_PREFIX/bin/sysup" 2>&1)
direct_dispatch_status=$?
set -e
_assert_eq "sysup install: direct link loads provider detection" \
  "1" "$direct_dispatch_status"
_assert_contains "sysup install: direct link reports the detected host" \
  "ID=fedora" "$direct_dispatch_output"

set +e
PREFIX="$SYSUP_PREFIX" "$SYSUP_INSTALLER" >/dev/null 2>&1
SYSUP_REINSTALL_STATUS=$?
set -e
_assert_eq "sysup install: direct reinstall succeeds" \
  "0" "$SYSUP_REINSTALL_STATUS"
_assert_eq "sysup install: reinstall is idempotent" \
  "$REPO_ROOT/bin/sysup" "$(readlink "$SYSUP_PREFIX/bin/sysup")"

SYSUP_CURL_SOURCE=$(_tmpdir)
SYSUP_CURL_REMOTE=$(_tmpdir)/sysup.git
SYSUP_CURL_CHECKOUT_PARENT=$(_tmpdir)
SYSUP_CURL_CHECKOUT=$(cd -P -- "$SYSUP_CURL_CHECKOUT_PARENT" && pwd -P)/sysup
SYSUP_CURL_PREFIX=$(_tmpdir)
cp "$SYSUP_INSTALLER" "$SYSUP_CURL_SOURCE/install.sh"
cp -R "$REPO_ROOT/bin" "$REPO_ROOT/lib" "$REPO_ROOT/support" \
  "$SYSUP_CURL_SOURCE/"
git -C "$SYSUP_CURL_SOURCE" init --quiet --initial-branch=main --template=''
git -C "$SYSUP_CURL_SOURCE" config core.hooksPath /dev/null
git -C "$SYSUP_CURL_SOURCE" config commit.gpgsign false
git -C "$SYSUP_CURL_SOURCE" config user.name 'sysup installer test'
git -C "$SYSUP_CURL_SOURCE" config user.email sysup-installer@example.invalid
git -C "$SYSUP_CURL_SOURCE" add .
git -C "$SYSUP_CURL_SOURCE" commit --quiet -m 'curl installer fixture'
git init --quiet --bare --initial-branch=main "$SYSUP_CURL_REMOTE"
git -C "$SYSUP_CURL_SOURCE" remote add origin "$SYSUP_CURL_REMOTE"
git -C "$SYSUP_CURL_SOURCE" push --quiet --set-upstream origin main
SYSUP_CURL_OUTPUT=$(_tmpdir)/curl.out
set +e
curl --fail --silent --show-error "file://$SYSUP_INSTALLER" |
  PREFIX="$SYSUP_CURL_PREFIX" \
    CGRAF78_CHECKOUT_INSTALL_DIR="$SYSUP_CURL_CHECKOUT" \
    CGRAF78_CHECKOUT_INSTALL_REPO_URL="file://$SYSUP_CURL_REMOTE" \
    bash -s >"$SYSUP_CURL_OUTPUT" 2>&1
SYSUP_CURL_PIPELINE_STATUS=("${PIPESTATUS[@]}")
set -e
_assert_eq "sysup install: curl transport succeeds" \
  "0" "${SYSUP_CURL_PIPELINE_STATUS[0]}"
_assert_eq "sysup install: managed checkout succeeds" \
  "0" "${SYSUP_CURL_PIPELINE_STATUS[1]}"
if [[ -f "$SYSUP_CURL_CHECKOUT/.git/HEAD" ]]; then
  _pass "sysup install: curl bootstrap keeps a durable checkout"
else
  _fail "sysup install: curl bootstrap keeps a durable checkout"
fi
_assert_eq "sysup install: curl link selects the managed checkout" \
  "$SYSUP_CURL_CHECKOUT/bin/sysup" \
  "$(readlink "$SYSUP_CURL_PREFIX/bin/sysup")"
SYSUP_CURL_OS_ROOT=$(_sysup_os_root)
_sysup_write_os_release "$SYSUP_CURL_OS_ROOT" 'ID=fedora'
set +e
curl_dispatch_output=$(SYSUP_OS_ROOT="$SYSUP_CURL_OS_ROOT" \
  "$SYSUP_CURL_PREFIX/bin/sysup" 2>&1)
curl_dispatch_status=$?
set -e
_assert_eq "sysup install: curl link loads provider detection" \
  "1" "$curl_dispatch_status"
_assert_contains "sysup install: curl link reports the detected host" \
  "ID=fedora" "$curl_dispatch_output"

SYSUP_CUSTOM_BIN=$(_tmpdir)/commands
BIN_DIR="$SYSUP_CUSTOM_BIN" "$SYSUP_INSTALLER_DELEGATE" >/dev/null
_assert_eq "sysup install: honors BIN_DIR" \
  "$REPO_ROOT/bin/sysup" "$(readlink "$SYSUP_CUSTOM_BIN/sysup")"

SYSUP_BLOCKED_BIN=$(_tmpdir)/commands
mkdir -p "$SYSUP_BLOCKED_BIN"
printf 'owned elsewhere\n' >"$SYSUP_BLOCKED_BIN/sysup"
set +e
blocked_output=$(BIN_DIR="$SYSUP_BLOCKED_BIN" "$SYSUP_INSTALLER_DELEGATE" 2>&1)
blocked_status=$?
set -e
_assert_eq "sysup install: refuses a non-symlink destination" "1" "$blocked_status"
_assert_eq "sysup install: preserves a non-symlink destination" \
  "owned elsewhere" "$(cat "$SYSUP_BLOCKED_BIN/sysup")"
_assert_contains "sysup install: destination refusal is actionable" \
  "refusing to replace non-symlink" "$blocked_output"

SYSUP_MISSING_ROOT=$(_tmpdir)
SYSUP_MISSING_PREFIX=$(_tmpdir)
mkdir -p "$SYSUP_MISSING_ROOT/support"
cp "$SYSUP_INSTALLER_DELEGATE" \
  "$SYSUP_MISSING_ROOT/support/install-checkout.sh"
set +e
missing_output=$(PREFIX="$SYSUP_MISSING_PREFIX" \
  "$SYSUP_MISSING_ROOT/support/install-checkout.sh" 2>&1)
missing_status=$?
set -e
_assert_eq "sysup install: missing command source fails" "1" "$missing_status"
if [[ ! -e "$SYSUP_MISSING_PREFIX/bin/sysup" &&
  ! -L "$SYSUP_MISSING_PREFIX/bin/sysup" ]]; then
  _pass "sysup install: missing source publishes no command"
else
  _fail "sysup install: missing source publishes no command"
fi
_assert_contains "sysup install: missing source is actionable" \
  "command source is not executable" "$missing_output"

echo ""
echo "=== sysup: dispatcher portability ==="

# The dispatcher and detect.sh are the only parts that must run on a host sysup
# cannot upgrade, so they are held to bash 3.2 (what macOS ships as /bin/bash).
# The backends and the shared driver are Linux-only and may use bash 4 freely.
detect_source=$(cat "$REPO_ROOT/lib/sysup/detect.sh")
dispatcher_source=$(cat "$REPO_ROOT/bin/sysup")
_assert_contains "sysup portability: detect.sh was read for the scan" \
  "sysup_os_family" "$detect_source"
_assert_contains "sysup portability: the dispatcher was read for the scan" \
  "resolve_backend" "$dispatcher_source"
for portability_source in "$detect_source" "$dispatcher_source"; do
  _assert_not_contains "sysup portability: no associative arrays (need bash 4)" \
    "declare -A" "$portability_source"
  _assert_not_contains "sysup portability: no mapfile (needs bash 4)" \
    "mapfile" "$portability_source"
  _assert_not_contains "sysup portability: no \${var^^} case conversion (needs bash 4)" \
    '^^' "$portability_source"
done

# The family lookups replaced associative arrays; prove they still resolve.
_assert_eq "sysup families: arch resolves to its backend" \
  "archup" "$(sysup_family_command arch)"
_assert_eq "sysup families: debian resolves to its backend" \
  "debup" "$(sysup_family_command debian)"
_assert_eq "sysup families: arch resolves to its label" \
  "Arch Linux" "$(sysup_family_label arch)"
_assert_eq "sysup families: debian resolves to its label" \
  "Debian-based" "$(sysup_family_label debian)"
set +e
sysup_family_command fedora >/dev/null
status=$?
set -e
_assert_eq "sysup families: an unknown family has no backend" "1" "$status"

_test_summary
