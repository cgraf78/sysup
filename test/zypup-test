sysup_require_family() { return 0; }
_assert_eq "zypup main: refuses to run on a non-SUSE host" "1" "$ZYPUP_STATUS"
_assert_contains "zypup main: names the host it refused" \
  "only supports openSUSE/SUSE-based hosts" "$ZYPUP_RESULT"
