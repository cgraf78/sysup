#!/usr/bin/env bash
# common-test - unit tests for the shared sysup driver in lib/sysup/common.sh:
# argument parsing, the sudo credential keeper, and package-manager lock waits.
#
# A minimal fake backend supplies the hooks, so these cases exercise the
# driver itself rather than any package manager.

set -euo pipefail
export NO_COLOR=1

TEST_DIR=$(CDPATH='' cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO_ROOT=$(cd "$TEST_DIR/.." && pwd)
# shellcheck source=lib/test.sh
. "$TEST_DIR/lib/test.sh"

COMMON_MOCK_BIN=$(_mock_bin)
export PATH="$COMMON_MOCK_BIN:$PATH"

COMMON_SUDO_LOG="$(_tmpdir)/sudo.log"
COMMON_UPGRADE_LOG="$(_tmpdir)/upgrade.log"
export COMMON_SUDO_LOG COMMON_UPGRADE_LOG
export COMMON_SUDO_REFRESH_STATUS=0
export COMMON_SUDO_WARM_STATUS=0
export COMMON_SUDO_VALIDATE_STATUS=0
export COMMON_SUDO_CACHED_STATUS=0
COMMON_SUDO_ALERT_LOG="$(_tmpdir)/sudo-alert.log"
export COMMON_SUDO_ALERT_LOG

# sudo is a real executable so the keeper's background subshell, which has no
# access to later function redefinitions, still reaches the mock.
cat >"$COMMON_MOCK_BIN/sudo" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$COMMON_SUDO_LOG"
case "$*" in
  -v) exit "$COMMON_SUDO_VALIDATE_STATUS" ;;
  true) exit "$COMMON_SUDO_WARM_STATUS" ;;
  "-n -v") exit "$COMMON_SUDO_REFRESH_STATUS" ;;
  "-n true") exit "$COMMON_SUDO_CACHED_STATUS" ;;
  "-n -k true")
    # A refused command probe is an alert even with stderr redirected.
    printf 'password is required\n' >>"$COMMON_SUDO_ALERT_LOG"
    exit 1
    ;;
esac
[[ "$1" != -n ]] || shift
exec "$@"
EOF
chmod +x "$COMMON_MOCK_BIN/sudo"

# Never read or write the host's deferred-restart state or boot identity.
SYSUP_STATE_DIR="$(_tmpdir)/state"
SYSUP_BOOT_ID_FILE="$(_tmpdir)/boot_id"
printf 'boot-a\n' >"$SYSUP_BOOT_ID_FILE"
export SYSUP_STATE_DIR SYSUP_BOOT_ID_FILE

# shellcheck source=../lib/sysup/common.sh
. "$REPO_ROOT/lib/sysup/common.sh"

# The fake backend. Its upgrade can be slowed so the keeper has time to run,
# can change the installed set, and can record notices or report extras.
COMMON_UPGRADE_SECONDS=0
COMMON_UPGRADE_STATUS=0
COMMON_SNAPSHOT="$(_tmpdir)/snapshot"
COMMON_UPGRADE_SNAPSHOT=""
COMMON_UPGRADE_NOTICES=()
COMMON_UPGRADE_EXTRAS=()
COMMON_PROBE_STDIN=0
COMMON_AUTOREMOVE_LOG="$(_tmpdir)/autoremove.log"
COMMON_EXCLUDE_LOG="$(_tmpdir)/exclude.log"
COMMON_HOOK_STATE="$(_tmpdir)/hook-state"
# shellcheck disable=SC2329 # hooks are invoked indirectly by sysup_main.
sysup_backend_require() { return 0; }
# shellcheck disable=SC2329
sysup_backend_usage() { printf 'Usage: sysup [-- fake args...]\n'; }
# shellcheck disable=SC2329
sysup_backend_snapshot() { cat "$COMMON_SNAPSHOT"; }
# shellcheck disable=SC2329
sysup_backend_package_files() { return 0; }
# shellcheck disable=SC2329
sysup_backend_upgrade() {
  local entry line

  printf '%s\n' "$*" >>"$COMMON_UPGRADE_LOG"
  # What the package-manager step saw: a shutdown inhibitor and stdin.
  if [[ -n "$_SYSUP_INHIBIT_PID" ]] && kill -0 "$_SYSUP_INHIBIT_PID" 2>/dev/null; then
    printf 'inhibitor=%s\n' "$_SYSUP_INHIBIT_PID" >>"$COMMON_HOOK_STATE"
  fi
  if [[ -n "${COMMON_INHIBIT_LOG:-}" ]] && [[ -s "$COMMON_INHIBIT_LOG" ]] &&
    [[ "$(<"$COMMON_INHIBIT_LOG")" == *'lock granted'* ]]; then
    printf 'lock granted\n' >>"$COMMON_HOOK_STATE"
  fi
  if ((COMMON_PROBE_STDIN)) && IFS= read -r -t 1 line; then
    printf 'stdin=%s\n' "$line" >>"$COMMON_HOOK_STATE"
  fi
  sleep "$COMMON_UPGRADE_SECONDS"
  [[ -z "$COMMON_UPGRADE_SNAPSHOT" ]] || printf '%s\n' "$COMMON_UPGRADE_SNAPSHOT" >"$COMMON_SNAPSHOT"
  for entry in "${COMMON_UPGRADE_NOTICES[@]+"${COMMON_UPGRADE_NOTICES[@]}"}"; do
    # A `kind:subject` entry names its subject; a bare kind gets a fixed one.
    if [[ "$entry" == warning ]]; then
      sysup_warn "fake upgrade warning"
    elif [[ "$entry" == *:* ]]; then
      sysup_notice "${entry%%:*}" "${entry#*:}"
    else
      sysup_notice "$entry" "fake $entry"
    fi
  done
  SYSUP_EXTRA_UPGRADED_PACKAGES+=("${COMMON_UPGRADE_EXTRAS[@]+"${COMMON_UPGRADE_EXTRAS[@]}"}")
  return "$COMMON_UPGRADE_STATUS"
}
# shellcheck disable=SC2329
sysup_backend_autoremove() {
  printf '%s\n' "$1" >>"$COMMON_AUTOREMOVE_LOG"
}
# shellcheck disable=SC2329
sysup_backend_parse_arg() {
  [[ "$1" == --fake-flag ]]
}
# No systemd is involved in these cases.
# shellcheck disable=SC2329
sysup_report_failed_units() { return 0; }

_common_reset() {
  : >"$COMMON_SUDO_LOG"
  : >"$COMMON_UPGRADE_LOG"
  : >"$COMMON_AUTOREMOVE_LOG"
  : >"$COMMON_EXCLUDE_LOG"
  : >"$COMMON_HOOK_STATE"
  printf 'base 1.0\n' >"$COMMON_SNAPSHOT"
  COMMON_UPGRADE_SNAPSHOT=""
  COMMON_UPGRADE_NOTICES=()
  COMMON_UPGRADE_EXTRAS=()
  COMMON_PROBE_STDIN=0
  COMMON_UPGRADE_SECONDS=0
  COMMON_UPGRADE_STATUS=0
  COMMON_SUDO_REFRESH_STATUS=0
  COMMON_SUDO_WARM_STATUS=0
  COMMON_SUDO_VALIDATE_STATUS=0
  COMMON_SUDO_CACHED_STATUS=0
  : >"$COMMON_SUDO_ALERT_LOG"
  SYSUP_SUDO_REFRESH=60
}

_common_main() {
  set +e
  COMMON_RESULT=$(sysup_main "$@" 2>&1)
  COMMON_STATUS=$?
  set -e
}

# Poll `condition` (a command string) until it succeeds or `seconds` pass.
_common_poll() {
  local condition="$1" seconds="$2" i

  for ((i = 0; i < seconds * 10; i++)); do
    eval "$condition" && return 0
    sleep 0.1
  done
  return 1
}

_common_refresh_count() {
  grep -cx -- '-n -v' "$COMMON_SUDO_LOG" || true
}

_common_alive() {
  kill -0 "$1" 2>/dev/null
}

echo "=== common: argument parsing ==="

_common_reset
_common_main --frobnicate
_assert_eq "common args: an unknown option is a usage error" "2" "$COMMON_STATUS"
_assert_contains "common args: names the unknown option" \
  "unknown argument: --frobnicate" "$COMMON_RESULT"
_assert_contains "common args: says how to pass package-manager arguments" \
  "sysup -- --frobnicate" "$COMMON_RESULT"
_assert_eq "common args: an unknown option runs nothing" \
  "" "$(cat "$COMMON_UPGRADE_LOG")$(cat "$COMMON_SUDO_LOG")"

_common_reset
_common_main some-package
_assert_eq "common args: a bare word before -- is rejected" "2" "$COMMON_STATUS"

_common_reset
_common_main --fake-flag -- --pm-flag 'two words'
_assert_eq "common args: backend flags and -- arguments are accepted (output: $COMMON_RESULT)" \
  "0" "$COMMON_STATUS"
_assert_eq "common args: arguments after -- reach the upgrade unchanged" \
  "--pm-flag two words" "$(cat "$COMMON_UPGRADE_LOG")"

_common_reset
_common_main -- --frobnicate
_assert_eq "common args: anything after -- is passed through, even option-like words" \
  "--frobnicate" "$(cat "$COMMON_UPGRADE_LOG")"

_common_reset
_common_main --help --frobnicate
_assert_eq "common args: --help before an unknown option still prints help" \
  "0" "$COMMON_STATUS"

echo ""
echo "=== common: sudo keeper ==="

if ((EUID == 0)); then
  # The keeper deliberately never starts as root, so these cases do not apply.
  _pass "common keeper: skipped when the suite runs as root"
else
  # Refreshes while a long upgrade runs, then stops when the run returns.
  _common_reset
  SYSUP_SUDO_REFRESH=0.2
  COMMON_UPGRADE_SECONDS=1
  _common_main
  _assert_eq "common keeper: the run succeeds (output: $COMMON_RESULT)" "0" "$COMMON_STATUS"
  refreshes=$(_common_refresh_count)
  if ((refreshes >= 2)); then
    _pass "common keeper: refreshes sudo during a long upgrade ($refreshes refreshes)"
  else
    _fail "common keeper: refreshes sudo during a long upgrade ($refreshes refreshes)"
  fi
  sleep 0.6
  _assert_eq "common keeper: no refresh after the run returns" \
    "$refreshes" "$(_common_refresh_count)"

  # Run the driver in this shell, not a command substitution: a subshell's
  # exit would end the keeper by itself and hide a missing stop.
  _common_reset
  SYSUP_SUDO_REFRESH=0.2
  COMMON_UPGRADE_SECONDS=0.5
  set +e
  sysup_main >/dev/null 2>&1
  status=$?
  set -e
  _assert_eq "common keeper: an in-shell run succeeds" "0" "$status"
  _assert_eq "common keeper: the run clears the keeper pid" "" "$_SYSUP_SUDO_KEEPER_PID"
  refreshes=$(_common_refresh_count)
  sleep 0.6
  _assert_eq "common keeper: an in-shell run leaves no keeper refreshing" \
    "$refreshes" "$(_common_refresh_count)"

  # The keeper must be gone on a failing upgrade's return path too.
  _common_reset
  SYSUP_SUDO_REFRESH=0.2
  COMMON_UPGRADE_SECONDS=0.5
  COMMON_UPGRADE_STATUS=7
  _common_main
  _assert_eq "common keeper: the upgrade status is kept" "7" "$COMMON_STATUS"
  refreshes=$(_common_refresh_count)
  sleep 0.6
  _assert_eq "common keeper: no refresh after a failed run returns" \
    "$refreshes" "$(_common_refresh_count)"

  # Stop terminates the keeper and its sleep child, and is idempotent.
  _common_reset
  SYSUP_SUDO_REFRESH=30
  sysup_start_sudo_keeper
  keeper="$_SYSUP_SUDO_KEEPER_PID"
  _common_poll "pgrep -P $keeper >/dev/null" 5 || true
  sleeper=$(pgrep -P "$keeper" || true)
  if [[ -n "$sleeper" ]]; then
    _pass "common keeper: sleeps in an owned child"
  else
    _fail "common keeper: sleeps in an owned child"
  fi
  sysup_stop_sudo_keeper
  if ! _common_alive "$keeper"; then
    _pass "common keeper: stop terminates the keeper"
  else
    _fail "common keeper: stop terminates the keeper"
  fi
  if [[ -n "$sleeper" ]] && _common_poll "! kill -0 $sleeper 2>/dev/null" 5; then
    _pass "common keeper: stop leaves no sleep process behind"
  else
    _fail "common keeper: stop leaves no sleep process behind"
  fi
  _assert_eq "common keeper: stop clears the recorded pid" "" "$_SYSUP_SUDO_KEEPER_PID"
  set +e
  sysup_stop_sudo_keeper
  status=$?
  set -e
  _assert_eq "common keeper: a second stop is a no-op" "0" "$status"

  # Only one keeper per run.
  _common_reset
  SYSUP_SUDO_REFRESH=30
  sysup_start_sudo_keeper
  first="$_SYSUP_SUDO_KEEPER_PID"
  sysup_start_sudo_keeper
  _assert_eq "common keeper: starting twice keeps one keeper" \
    "$first" "$_SYSUP_SUDO_KEEPER_PID"
  sysup_stop_sudo_keeper

  # A refused noninteractive refresh (credentials revoked) ends the keeper.
  _common_reset
  # shellcheck disable=SC2034 # read by the sourced common.sh under test.
  SYSUP_SUDO_REFRESH=0.1
  COMMON_SUDO_REFRESH_STATUS=1
  export COMMON_SUDO_REFRESH_STATUS
  sysup_start_sudo_keeper
  keeper="$_SYSUP_SUDO_KEEPER_PID"
  if _common_poll "! kill -0 $keeper 2>/dev/null" 5; then
    _pass "common keeper: exits when sudo refuses a refresh"
  else
    _fail "common keeper: exits when sudo refuses a refresh"
  fi
  sysup_stop_sudo_keeper
  COMMON_SUDO_REFRESH_STATUS=0

  # A parent that dies without cleanup must not leave the keeper looping.
  orphan_pid_file="$(_tmpdir)/keeper.pid"
  SYSUP_SUDO_REFRESH=0.1 bash -c '
    . "$1/lib/sysup/common.sh"
    sysup_start_sudo_keeper
    printf "%s\n" "$_SYSUP_SUDO_KEEPER_PID" >"$2"
  ' _ "$REPO_ROOT" "$orphan_pid_file"
  orphan=$(cat "$orphan_pid_file")
  if [[ -n "$orphan" ]] && _common_poll "! kill -0 $orphan 2>/dev/null" 5; then
    _pass "common keeper: exits on its own when the run dies without cleanup"
  else
    _fail "common keeper: exits on its own when the run dies without cleanup"
    kill "$orphan" 2>/dev/null || true
  fi

  _common_reset
  SYSUP_SUDO_REFRESH=0
  sysup_start_sudo_keeper
  _assert_eq "common keeper: an interval of 0 disables it" "" "$_SYSUP_SUDO_KEEPER_PID"
  SYSUP_SUDO_REFRESH=soon
  sysup_start_sudo_keeper
  _assert_eq "common keeper: an invalid interval disables it" "" "$_SYSUP_SUDO_KEEPER_PID"

  _common_reset
  # shellcheck disable=SC2034 # read by the sourced common.sh under test.
  SYSUP_SUDO_REFRESH=0.1
  _common_main --check-only
  sleep 0.3
  _assert_eq "common keeper: --check-only never starts it" \
    "0" "$(_common_refresh_count)"

  # Warming must use the real authentication path, without a deliberately
  # refused noninteractive command that sudo can report to the administrator.
  _common_reset
  _common_main
  _assert_eq "common sudo: a password host succeeds" "0" "$COMMON_STATUS"
  _assert_contains "common sudo: warms through an ordinary command" \
    $'\ntrue\n' $'\n'"$(cat "$COMMON_SUDO_LOG")"$'\n'
  _assert_eq "common sudo: warming causes no refused-command alert" \
    "" "$(cat "$COMMON_SUDO_ALERT_LOG")"

  # Mixed PASSWD and NOPASSWD ALL policies can refuse sudo -v while allowing
  # every actual command without a password. Warming must not validate there.
  _common_reset
  COMMON_SUDO_VALIDATE_STATUS=1
  COMMON_SUDO_REFRESH_STATUS=1
  COMMON_UPGRADE_SECONDS=0.5
  # shellcheck disable=SC2034 # read by the sourced common.sh under test.
  SYSUP_SUDO_REFRESH=0.1
  _common_main
  _assert_eq "common sudo: mixed passwordless policy succeeds" "0" "$COMMON_STATUS"
  _assert_not_contains "common sudo: mixed policy never prompts for validation" \
    $'\n-v\n' $'\n'"$(cat "$COMMON_SUDO_LOG")"$'\n'
  _assert_eq "common sudo: a refused validation stops the keeper" \
    "1" "$(_common_refresh_count)"
  _assert_eq "common sudo: mixed policy causes no refused-command alert" \
    "" "$(cat "$COMMON_SUDO_ALERT_LOG")"

  # A cancelled initial prompt must not reach the upgrade or start a keeper.
  _common_reset
  COMMON_SUDO_WARM_STATUS=1
  _common_main
  _assert_eq "common sudo: warming failure fails the run" "1" "$COMMON_STATUS"
  _assert_eq "common sudo: warming failure skips the upgrade" \
    "" "$(cat "$COMMON_UPGRADE_LOG")"
  _assert_eq "common sudo: warming failure starts no keeper" \
    "0" "$(_common_refresh_count)"

fi

echo ""
echo "=== common: lock waits ==="

# A fixture process table: pid 101 holds the lock file open, pid 202 does not.
SYSUP_PROC_ROOT=$(_tmpdir)
lock_file="$(_tmpdir)/lists.lock"
: >"$lock_file"
mkdir -p "$SYSUP_PROC_ROOT/101/fd" "$SYSUP_PROC_ROOT/202/fd" "$SYSUP_PROC_ROOT/self"
ln -s /dev/null "$SYSUP_PROC_ROOT/101/fd/0"
ln -s "$lock_file" "$SYSUP_PROC_ROOT/101/fd/7"
ln -s /dev/null "$SYSUP_PROC_ROOT/202/fd/0"

# Holder detection needs a find with -lname. Every supported family ships GNU
# findutils, but the shared CI matrix also runs BusyBox (Alpine), whose find
# lacks it; there the documented fallback, reporting the file free, is what
# must hold instead.
COMMON_FIND_LNAME=0
if find "$SYSUP_PROC_ROOT" -maxdepth 0 -lname x >/dev/null 2>&1; then
  COMMON_FIND_LNAME=1
fi

if ((COMMON_FIND_LNAME)); then
  if sysup_path_in_use "$lock_file"; then
    _pass "common lock: a process with the file open holds it"
  else
    _fail "common lock: a process with the file open holds it"
  fi
elif ! sysup_path_in_use "$lock_file"; then
  _pass "common lock: without find -lname the scan reports free"
else
  _fail "common lock: without find -lname the scan reports free"
fi
if ! sysup_path_in_use "$(_tmpdir)/other.lock"; then
  _pass "common lock: a file no process has open is free"
else
  _fail "common lock: a file no process has open is free"
fi

# Only <pid>/fd counts: a link under a non-numeric entry or deeper in a pid's
# tree (thread directories, say) is not a holder the scan should report.
stray_proc=$(_tmpdir)
mkdir -p "$stray_proc/self/fd" "$stray_proc/303/task/303/fd"
ln -s "$lock_file" "$stray_proc/self/fd/7"
ln -s "$lock_file" "$stray_proc/303/task/303/fd/7"
if ! SYSUP_PROC_ROOT="$stray_proc" sysup_path_in_use "$lock_file"; then
  _pass "common lock: links outside <pid>/fd are ignored"
else
  _fail "common lock: links outside <pid>/fd are ignored"
fi

if ((EUID != 0)); then
  : >"$COMMON_SUDO_LOG"
  sysup_path_in_use "$lock_file" || true
  _assert_contains "common lock: the scan runs as root without prompting" \
    "-n find $SYSUP_PROC_ROOT" "$(cat "$COMMON_SUDO_LOG")"
fi

empty_proc=$(_tmpdir)
saved_proc="$SYSUP_PROC_ROOT"
SYSUP_PROC_ROOT="$empty_proc"
if ! sysup_path_in_use "$lock_file"; then
  _pass "common lock: an empty process table means free"
else
  _fail "common lock: an empty process table means free"
fi
SYSUP_PROC_ROOT="$saved_proc"

# shellcheck disable=SC2034 # read by the sourced common.sh under test.
SYSUP_LOCK_POLL=0.1
set +e
result=$(sysup_wait_path_free "$(_tmpdir)/other.lock" 1 "the test lock" 2>&1)
status=$?
set -e
_assert_eq "common lock: a free lock needs no wait" "0" "$status"
_assert_eq "common lock: a free lock prints nothing" "" "$result"

if ((COMMON_FIND_LNAME)); then
  set +e
  result=$(sysup_wait_path_free "$lock_file" 1 "the test lock" 2>&1)
  status=$?
  set -e
  _assert_eq "common lock: a lock held past the deadline fails" "1" "$status"
  _assert_contains "common lock: says what it waited for" \
    "waiting up to 1s for the test lock" "$result"
  _assert_contains "common lock: says the deadline passed" \
    "the test lock is still held" "$result"
fi

# The holder lets go partway through the wait.
(
  sleep 0.3
  rm -f "$SYSUP_PROC_ROOT/101/fd/7"
) &
releaser=$!
set +e
result=$(sysup_wait_path_free "$lock_file" 5 "the test lock" 2>&1)
status=$?
set -e
wait "$releaser"
_assert_eq "common lock: returns once the holder releases the lock" "0" "$status"

echo ""
echo "=== common: advisory scans as root ==="

# Root runs every scan directly, so only a non-root runner reaches sudo.
if ((EUID != 0)); then
  _common_reset
  result=$(sysup_scan_as_root echo scanned)
  _assert_eq "common scan: runs the command" "scanned" "$result"
  _assert_contains "common scan: uses sudo when it needs no password" \
    "-n echo scanned" "$(cat "$COMMON_SUDO_LOG")"

  _common_reset
  set +e
  sysup_scan_as_root false
  status=$?
  set -e
  _assert_eq "common scan: keeps the command's exit status under sudo" "1" "$status"

  _common_reset
  COMMON_SUDO_CACHED_STATUS=1
  result=$(sysup_scan_as_root echo scanned)
  _assert_eq "common scan: falls back to the invoking user" "scanned" "$result"
  _assert_eq "common scan: never prompts for a password" \
    "-n true" "$(cat "$COMMON_SUDO_LOG")"

  _common_reset
  result=$(
    # shellcheck disable=SC2123 # deliberately leave no sudo on PATH.
    PATH=/nonexistent
    sysup_scan_as_root echo scanned
  )
  _assert_eq "common scan: runs as the invoking user without sudo" "scanned" "$result"
  _assert_eq "common scan: does not need sudo installed" "" "$(cat "$COMMON_SUDO_LOG")"
fi

echo ""
echo "=== common: notices ==="

notice_file=$(_tmpfile)
_SYSUP_NOTICE_FILE="$notice_file"
sysup_notice reboot-required
sysup_notice config-merge /etc/a.pacnew '/etc/my app.pacnew' $'/etc/x\n.pacnew'
result=$(sysup_warn 'disk almost full' 2>&1)
_assert_eq "common notices: sysup_warn prints the usual warning line" \
  "warning: disk almost full" "$result"
_assert_eq "common notices: each subject is one kind<TAB>subject line" \
  $'reboot-required\t\nconfig-merge\t/etc/a.pacnew\nconfig-merge\t/etc/my app.pacnew\nconfig-merge\t/etc/x .pacnew\nwarning\tdisk almost full' \
  "$(cat "$notice_file")"
_assert_eq "common notices: kinds are listed in order" \
  $'reboot-required\nconfig-merge\nconfig-merge\nconfig-merge\nwarning' "$(sysup_notice_kinds "$notice_file")"
_assert_eq "common notices: standing keys leave out warnings, sorted and unique" \
  $'config-merge\t/etc/a.pacnew\nconfig-merge\t/etc/my app.pacnew\nconfig-merge\t/etc/x .pacnew\nreboot-required\t' \
  "$(sysup_cron_standing_notices "$notice_file")"
set +e
result=$(sysup_notice rebot-required 'typo' 2>&1)
status=$?
set -e
_assert_eq "common notices: an unknown kind is a programming error" "2" "$status"
_assert_contains "common notices: names the unknown kind" "rebot-required" "$result"
_assert_not_contains "common notices: an unknown kind is not recorded" \
  "typo" "$(cat "$notice_file")"
_SYSUP_NOTICE_FILE=""
result=$(sysup_notice reboot-required 'unrecorded' 2>&1)
_assert_eq "common notices: without a notice file nothing is printed" "" "$result"

echo ""
echo "=== common: --exclude ==="

_common_reset
_common_main --exclude=pkg-a
_assert_eq "common exclude: a backend without the hook rejects it with 2" "2" "$COMMON_STATUS"
_assert_contains "common exclude: says the backend cannot exclude" \
  "does not support --exclude" "$COMMON_RESULT"
_assert_eq "common exclude: rejection runs nothing" \
  "" "$(cat "$COMMON_UPGRADE_LOG")$(cat "$COMMON_SUDO_LOG")"

# shellcheck disable=SC2329 # invoked indirectly by sysup_main.
sysup_backend_exclude() {
  printf '%s\n' "$@" >"$COMMON_EXCLUDE_LOG"
}

_common_reset
_common_main --exclude=pkg-a,lib-b --exclude='kernel-*'
_assert_eq "common exclude: a supporting backend runs (output: $COMMON_RESULT)" \
  "0" "$COMMON_STATUS"
_assert_eq "common exclude: every name reaches the hook once, in order" \
  $'pkg-a\nlib-b\nkernel-*' "$(cat "$COMMON_EXCLUDE_LOG")"
_assert_eq "common exclude: names never become package-manager arguments" \
  "" "$(cat "$COMMON_UPGRADE_LOG")"
_assert_eq "common exclude: automatic cleanup still runs" \
  "apply" "$(cat "$COMMON_AUTOREMOVE_LOG")"
_assert_not_contains "common exclude: no custom-argument cleanup note" \
  "custom package-manager arguments" "$COMMON_RESULT"

for bad_exclude in --exclude= --exclude=pkg-a,,lib-b '--exclude=pkg-a,' \
  --exclude=,pkg-a --exclude=-rf '--exclude=two words' $'--exclude=pkg-a,\nlib-b' --exclude; do
  _common_reset
  _common_main "$bad_exclude"
  _assert_eq "common exclude: '$bad_exclude' is a usage error" "2" "$COMMON_STATUS"
  _assert_eq "common exclude: '$bad_exclude' runs nothing" \
    "" "$(cat "$COMMON_UPGRADE_LOG")$(cat "$COMMON_EXCLUDE_LOG")"
done

_common_reset
_common_main -- --exclude=pkg-a
_assert_eq "common exclude: after -- it is a package-manager argument" \
  "--exclude=pkg-a" "$(cat "$COMMON_UPGRADE_LOG")"
_assert_eq "common exclude: after -- the hook is not called" \
  "" "$(cat "$COMMON_EXCLUDE_LOG")"

echo ""
echo "=== common: --cron ==="

# Host state lives in temporary paths, and a fake systemd-inhibit stands in
# for the real one: it logs its options and runs the watcher it was given.
SYSUP_RUN_DIR="$(_tmpdir)/run"
SYSUP_SHUTDOWN_SCHEDULED_FILE="$(_tmpdir)/scheduled"
SYSUP_SYSTEMD_RUN_DIR=$(_tmpdir)
COMMON_INHIBIT_LOG="$(_tmpdir)/inhibit.log"
COMMON_SYSTEMCTL_LOG="$(_tmpdir)/systemctl.log"
export COMMON_INHIBIT_LOG COMMON_SYSTEMCTL_LOG
export COMMON_INHIBIT_DELAY=0 COMMON_INHIBIT_FAIL=0
cat >"$COMMON_MOCK_BIN/systemd-inhibit" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$COMMON_INHIBIT_LOG"
((COMMON_INHIBIT_FAIL == 0)) || exit 1
sleep "$COMMON_INHIBIT_DELAY"
printf 'lock granted\n' >>"$COMMON_INHIBIT_LOG"
while [[ "${1:-}" == --* ]]; do shift; done
exec "$@"
EOF
# Present so sysup_systemd_running sees systemd; nothing here may call it.
cat >"$COMMON_MOCK_BIN/systemctl" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$COMMON_SYSTEMCTL_LOG"
exit 1
EOF
chmod +x "$COMMON_MOCK_BIN/systemd-inhibit" "$COMMON_MOCK_BIN/systemctl"

# --cron needs util-linux flock, which every supported Linux family ships but
# the shared matrix's macOS and Termux hosts may lack. There a stand-in that
# always grants the lock keeps the other cases running; only the busy-lock
# case needs the real one.
COMMON_REAL_FLOCK=1
if ! command -v flock >/dev/null 2>&1; then
  COMMON_REAL_FLOCK=0
  printf '#!/usr/bin/env bash\nexit 0\n' >"$COMMON_MOCK_BIN/flock"
  chmod +x "$COMMON_MOCK_BIN/flock"
fi

COMMON_IS_ROOT=1
# shellcheck disable=SC2329 # invoked indirectly by sysup_main.
sysup_is_root() { ((COMMON_IS_ROOT)); }

_cron_reset() {
  _common_reset
  COMMON_IS_ROOT=1
  COMMON_INHIBIT_DELAY=0
  COMMON_INHIBIT_FAIL=0
  : >"$COMMON_INHIBIT_LOG"
  : >"$COMMON_SYSTEMCTL_LOG"
  rm -f "$SYSUP_SHUTDOWN_SCHEDULED_FILE"
  rm -rf "$SYSUP_STATE_DIR"
}

_cron_status_field() {
  sed -n "s/^$1=//p" "$SYSUP_STATE_DIR/last-cron"
}

_cron_reset
COMMON_IS_ROOT=0
_common_main --cron
_assert_eq "common cron: a non-root caller is a usage error" "2" "$COMMON_STATUS"
_assert_contains "common cron: says root is required" \
  "--cron must run as root" "$COMMON_RESULT"
_assert_eq "common cron: a non-root caller runs nothing" \
  "" "$(cat "$COMMON_UPGRADE_LOG")$(cat "$COMMON_SUDO_LOG")"
if [[ ! -e "$SYSUP_RUN_DIR" && ! -e "$SYSUP_STATE_DIR" ]]; then
  _pass "common cron: a non-root caller creates no state"
else
  _fail "common cron: a non-root caller creates no state"
fi

_cron_reset
_common_main --cron
_assert_eq "common cron: a no-op run succeeds" "0" "$COMMON_STATUS"
_assert_eq "common cron: a no-op run prints nothing" "" "$COMMON_RESULT"
_assert_eq "common cron: the upgrade still ran" "" "$(cat "$COMMON_UPGRADE_LOG")"
_assert_contains "common cron: keeps the last log" \
  "upgrading system" "$(cat "$SYSUP_STATE_DIR/last-cron.log")"
log_mode=$(LC_ALL=C ls -ld "$SYSUP_STATE_DIR/last-cron.log")
_assert_eq "common cron: the full log is private" "-rw-------" "${log_mode:0:10}"
_assert_eq "common cron: records the exit status" "0" "$(_cron_status_field status)"
_assert_eq "common cron: records no change" "no" "$(_cron_status_field changed)"
if [[ "$(_cron_status_field time)" =~ ^[0-9]+$ ]]; then
  _pass "common cron: records the time as epoch seconds"
else
  _fail "common cron: records the time as epoch seconds"
fi
_assert_eq "common cron: leaves no buffer behind" \
  "cron.lock" "$(ls "$SYSUP_RUN_DIR")"
_assert_eq "common cron: never calls systemctl itself" "" "$(cat "$COMMON_SYSTEMCTL_LOG")"

_cron_reset
COMMON_UPGRADE_STATUS=7
_common_main --cron
_assert_eq "common cron: the upgrade status stays final" "7" "$COMMON_STATUS"
_assert_contains "common cron: a failed run prints its log" \
  "the system upgrade failed (status 7)" "$COMMON_RESULT"
_assert_eq "common cron: records the failed status" "7" "$(_cron_status_field status)"

_cron_reset
COMMON_UPGRADE_SNAPSHOT="base 2.0"
_common_main --cron
_assert_eq "common cron: an upgrading run succeeds" "0" "$COMMON_STATUS"
_assert_contains "common cron: a package change prints the log" \
  "upgrading system" "$COMMON_RESULT"
_assert_eq "common cron: records the change" "yes" "$(_cron_status_field changed)"

# Installs and removals count, though the version diff ignores them.
_cron_reset
COMMON_UPGRADE_SNAPSHOT=$'base 1.0\nnew-dep 1.0'
_common_main --cron
_assert_contains "common cron: a new install prints the log" \
  "upgrading system" "$COMMON_RESULT"

_cron_reset
COMMON_UPGRADE_EXTRAS=(base)
_common_main --cron
_assert_contains "common cron: a same-version rebuild prints the log" \
  "upgrading system" "$COMMON_RESULT"
_assert_eq "common cron: a rebuild counts as a change" "yes" "$(_cron_status_field changed)"

for kind in reboot-required config-merge deferred-restart kept-back warning; do
  _cron_reset
  COMMON_UPGRADE_NOTICES=("$kind")
  _common_main --cron
  _assert_contains "common cron: a $kind notice prints the log" \
    "upgrading system" "$COMMON_RESULT"
done

_cron_reset
COMMON_UPGRADE_NOTICES=(excluded-pending excluded-pending)
_common_main --cron
_assert_eq "common cron: excluded-pending notices alone stay silent" "" "$COMMON_RESULT"

_cron_reset
COMMON_UPGRADE_NOTICES=(excluded-pending reboot-required)
_common_main --cron
_assert_contains "common cron: excluded-pending with another notice prints the log" \
  "upgrading system" "$COMMON_RESULT"

# Standing notices mail only when the set gains a key since the last run
# that was not --check-only.
_cron_reset
COMMON_UPGRADE_NOTICES=(deferred-restart:vpn.service config-merge:/etc/a.pacnew)
_common_main --cron
_assert_contains "common cron: first standing notices print the log" \
  "upgrading system" "$COMMON_RESULT"
_assert_eq "common cron: the standing notices are kept as kind<TAB>subject keys" \
  $'config-merge\t/etc/a.pacnew\ndeferred-restart\tvpn.service' \
  "$(cat "$SYSUP_STATE_DIR/cron-notices")"
_common_main --cron
_assert_eq "common cron: the same standing notices again stay silent" "" "$COMMON_RESULT"
COMMON_UPGRADE_NOTICES=(config-merge:/etc/a.pacnew deferred-restart:vpn.service deferred-restart:vpn.service)
_common_main --cron
_assert_eq "common cron: order and repeats do not make a notice new" "" "$COMMON_RESULT"
COMMON_UPGRADE_NOTICES=(deferred-restart:vpn.service)
_common_main --cron
_assert_eq "common cron: a resolved notice alone stays silent" "" "$COMMON_RESULT"
COMMON_UPGRADE_NOTICES=(deferred-restart:vpn.service config-merge:/etc/a.pacnew)
_common_main --cron
_assert_contains "common cron: a resolved notice that reappears prints the log" \
  "upgrading system" "$COMMON_RESULT"
COMMON_UPGRADE_NOTICES=(deferred-restart:vpn.service config-merge:/etc/a.pacnew deferred-restart:db.service)
_common_main --cron
_assert_contains "common cron: a new subject of a standing kind prints the log" \
  "upgrading system" "$COMMON_RESULT"
COMMON_UPGRADE_NOTICES=(deferred-restart:vpn.service config-merge:/etc/a.pacnew deferred-restart:db.service reboot-required)
_common_main --cron
_assert_contains "common cron: a new standing kind prints the log" \
  "upgrading system" "$COMMON_RESULT"

_cron_reset
COMMON_UPGRADE_NOTICES=(reboot-required)
_common_main --cron
COMMON_UPGRADE_NOTICES=()
_common_main --cron --check-only
_assert_eq "common cron: a --check-only run keeps the baseline" \
  $'reboot-required\tfake reboot-required' "$(cat "$SYSUP_STATE_DIR/cron-notices")"
COMMON_UPGRADE_NOTICES=(reboot-required)
_common_main --cron
_assert_eq "common cron: after --check-only a known notice stays silent" "" "$COMMON_RESULT"

_cron_reset
COMMON_UPGRADE_NOTICES=(reboot-required:)
_common_main --cron
COMMON_INHIBIT_FAIL=1
_common_main --cron
_assert_eq "common cron: a run stopped before its checks keeps the baseline" \
  $'reboot-required\t' "$(cat "$SYSUP_STATE_DIR/cron-notices")"
COMMON_INHIBIT_FAIL=0
_common_main --cron
_assert_eq "common cron: a known subjectless notice stays silent" "" "$COMMON_RESULT"

_cron_reset
_common_main --cron --check-only
if [[ ! -e "$SYSUP_STATE_DIR/cron-notices" ]]; then
  _pass "common cron: a --check-only run writes no baseline"
else
  _fail "common cron: a --check-only run writes no baseline"
fi

_cron_reset
COMMON_UPGRADE_NOTICES=(reboot-required)
_common_main --cron
COMMON_UPGRADE_STATUS=7
_common_main --cron
_assert_contains "common cron: a failure with known notices prints the log" \
  "the system upgrade failed (status 7)" "$COMMON_RESULT"
COMMON_UPGRADE_STATUS=0
COMMON_UPGRADE_SNAPSHOT="base 2.0"
_common_main --cron
_assert_contains "common cron: a package change with known notices prints the log" \
  "upgrading system" "$COMMON_RESULT"
COMMON_UPGRADE_SNAPSHOT=""
COMMON_UPGRADE_NOTICES=(reboot-required warning)
_common_main --cron
_assert_contains "common cron: a warning with known notices prints the log" \
  "fake upgrade warning" "$COMMON_RESULT"
_common_main --cron
_assert_contains "common cron: a repeated warning prints the log again" \
  "fake upgrade warning" "$COMMON_RESULT"

_cron_reset
mkdir -p "$SYSUP_STATE_DIR/cron-notices"
COMMON_UPGRADE_NOTICES=(reboot-required)
_common_main --cron
_assert_contains "common cron: an unreadable baseline counts as empty" \
  "upgrading system" "$COMMON_RESULT"

_cron_reset
COMMON_PROBE_STDIN=1
set +e
COMMON_RESULT=$(sysup_main --cron 2>&1 <<<"y")
set -e
_assert_not_contains "common cron: the run reads nothing from cron's stdin" \
  "stdin=" "$(cat "$COMMON_HOOK_STATE")"

_cron_reset
COMMON_INHIBIT_DELAY=0.2
_common_main --cron
_assert_contains "common cron: the upgrade starts after the lock is granted" \
  "lock granted" "$(cat "$COMMON_HOOK_STATE")"
inhibit_pid=$(sed -n 's/^inhibitor=//p' "$COMMON_HOOK_STATE")
if [[ -n "$inhibit_pid" ]]; then
  _pass "common cron: the upgrade runs under a shutdown inhibitor"
else
  _fail "common cron: the upgrade runs under a shutdown inhibitor"
fi
_assert_contains "common cron: inhibits shutdown as sysup in block mode" \
  "--what=shutdown --who=sysup --mode=block" "$(cat "$COMMON_INHIBIT_LOG")"
if [[ -n "$inhibit_pid" ]] && _common_poll "! kill -0 $inhibit_pid 2>/dev/null" 5; then
  _pass "common cron: the inhibitor is released when the run ends"
else
  _fail "common cron: the inhibitor is released when the run ends"
fi

_cron_reset
COMMON_INHIBIT_FAIL=1
_common_main --cron
_assert_eq "common cron: inhibitor acquisition failure fails the run" "1" "$COMMON_STATUS"
_assert_contains "common cron: reports the inhibitor failure" \
  "could not acquire a shutdown inhibitor" "$COMMON_RESULT"
_assert_eq "common cron: inhibitor failure runs no package transaction" \
  "" "$(cat "$COMMON_UPGRADE_LOG")$(cat "$COMMON_AUTOREMOVE_LOG")"

_cron_reset
_common_main
_assert_eq "common cron: an ordinary run takes no inhibitor" "" "$(cat "$COMMON_INHIBIT_LOG")"

_cron_reset
saved_systemd_dir="$SYSUP_SYSTEMD_RUN_DIR"
SYSUP_SYSTEMD_RUN_DIR="$(_tmpdir)/absent"
_common_main --cron
SYSUP_SYSTEMD_RUN_DIR="$saved_systemd_dir"
_assert_eq "common cron: without systemd the upgrade runs uninhibited" "0" "$COMMON_STATUS"
_assert_eq "common cron: without systemd no inhibitor starts" "" "$(cat "$COMMON_INHIBIT_LOG")"

_cron_reset
: >"$SYSUP_SHUTDOWN_SCHEDULED_FILE"
_common_main --cron
_assert_eq "common cron: a scheduled shutdown skips the run successfully" "0" "$COMMON_STATUS"
_assert_contains "common cron: a scheduled shutdown prints one line" \
  "skipped; a shutdown is scheduled" "$COMMON_RESULT"
_assert_eq "common cron: a scheduled shutdown runs nothing" "" "$(cat "$COMMON_UPGRADE_LOG")"

# Another --cron run holds the lock: a background holder, polled until it
# has the lock rather than slept for.
if ((COMMON_REAL_FLOCK)); then
  _cron_reset
  lock_ready="$(_tmpdir)/lock-ready"
  (
    exec 9>>"$SYSUP_RUN_DIR/cron.lock"
    flock -n 9 || exit 1
    : >"$lock_ready"
    exec sleep 30
  ) &
  lock_holder=$!
  if _common_poll "[[ -e '$lock_ready' ]]" 5; then
    _common_main --cron
    _assert_eq "common cron: a held lock exits 75" "75" "$COMMON_STATUS"
    _assert_contains "common cron: a held lock prints one line" \
      "another sysup --cron run holds" "$COMMON_RESULT"
    _assert_eq "common cron: a held lock runs nothing" "" "$(cat "$COMMON_UPGRADE_LOG")"
  else
    _fail "common cron: the background lock holder never took the lock"
  fi
  kill "$lock_holder" 2>/dev/null || true
  wait "$lock_holder" 2>/dev/null || true
else
  _pass "common cron: busy-lock case skipped; this host has no flock"
fi

_cron_reset
_common_main --cron
_assert_eq "common cron: the lock is free again once its holder exits" "0" "$COMMON_STATUS"

_cron_reset
saved_run_dir="$SYSUP_RUN_DIR"
SYSUP_RUN_DIR="$(_tmpdir)/run-link"
ln -s "$(_tmpdir)" "$SYSUP_RUN_DIR"
_common_main --cron
_assert_eq "common cron: a symlinked run directory is refused" "1" "$COMMON_STATUS"
_assert_eq "common cron: a symlinked run directory runs nothing" "" "$(cat "$COMMON_UPGRADE_LOG")"
SYSUP_RUN_DIR="$(_tmpdir)/run-lock-link"
mkdir -p "$SYSUP_RUN_DIR"
ln -s "$(_tmpfile)" "$SYSUP_RUN_DIR/cron.lock"
_common_main --cron
_assert_eq "common cron: a symlinked lock file is refused" "1" "$COMMON_STATUS"
SYSUP_RUN_DIR="$saved_run_dir"

_cron_reset
_common_main --cron --help
_assert_eq "common cron: --help still succeeds" "0" "$COMMON_STATUS"
_assert_contains "common cron: --help is printed, not buffered" "Usage: sysup" "$COMMON_RESULT"

_cron_reset
_common_main --cron --frobnicate
_assert_eq "common cron: an unknown argument is still a usage error" "2" "$COMMON_STATUS"
_assert_contains "common cron: a usage error prints the log" \
  "unknown argument: --frobnicate" "$COMMON_RESULT"

_cron_reset
_common_main --cron -- --cron
_assert_eq "common cron: --cron after -- is a package-manager argument" \
  "--cron" "$(cat "$COMMON_UPGRADE_LOG")"

_test_summary
