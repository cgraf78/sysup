_assert_eq "debup main: partially applied upgrade preserves the apt failure" \
  "7" "$DEBUP_STATUS"
_assert_contains "debup main: partially applied upgrade continues with checks" \
  "continuing with best-effort post-upgrade checks" "$DEBUP_RESULT"
_assert_contains "debup main: partially applied upgrade checks package integrity" \
  "check" "$(cat "$DEBUP_APT_LOG")"
