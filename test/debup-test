_debup_reset
DEBUP_MOCK_INSTALLED="ii base 1.0"
DEBUP_MOCK_UPGRADE_STATUS=7
_debup_main
_assert_eq "debup main: propagates an apt-get upgrade failure" "7" "$DEBUP_STATUS"

_debup_reset
DEBUP_MOCK_INSTALLED="ii partial-service 1.0"
DEBUP_MOCK_UPGRADED="iF partial-service 2.0"
DEBUP_MOCK_PACKAGE_FILES=$'partial-service /usr/lib/systemd/system/partial.service'
DEBUP_MOCK_ACTIVE_UNITS="partial.service"
