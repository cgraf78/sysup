_debup_install_needrestart
DEBUP_MOCK_NEEDRESTART_OUTPUT="NEEDRESTART-KSTA: 1"
_debup_main
_assert_eq "debup main: failed post-upgrade snapshot preserves its status" \
  "8" "$DEBUP_STATUS"
_assert_contains "debup main: failed post-upgrade snapshot continues with checks" \
  "continuing with best-effort post-upgrade checks" "$DEBUP_RESULT"
_assert_contains "debup main: failed post-upgrade snapshot still checks integrity" \
  "check" "$(cat "$DEBUP_APT_LOG")"
_assert_contains "debup main: needrestart handles services when the package diff is unavailable" \
  "-r a" "$(cat "$DEBUP_NEEDRESTART_LOG")"
_assert_contains "debup main: failed post-upgrade snapshot still reports failed units" \
  "failed-after-snapshot.service" "$DEBUP_RESULT"

_debup_reset
DEBUP_MOCK_INSTALLED="ii base 1.0"
DEBUP_MOCK_AUDIT="half configured: broken-pkg"
_debup_main
_assert_eq "debup main: a failed check fails the run" "1" "$DEBUP_STATUS"

# The family guard is what stops debup running apt against a pacman system. Drop
# the stub for this one case so the guard is proven to run inside sysup_main.
_debup_reset
DEBUP_MOCK_INSTALLED="ii base 1.0"
debup_test_os_root=$(_tmpdir)
mkdir -p "$debup_test_os_root/etc"
printf 'ID=arch\n' >"$debup_test_os_root/etc/os-release"
# Restore the real guard for this case; unset alone would leave it undefined.
unset -f sysup_require_family
# shellcheck source=../lib/sysup/detect.sh
. "$REPO_ROOT/lib/sysup/detect.sh"
SYSUP_OS_ROOT="$debup_test_os_root"
_debup_main
# shellcheck disable=SC2034 # read by the sourced detect.sh.
SYSUP_OS_ROOT=""
# shellcheck disable=SC2329 # invoked indirectly by the sourced debup.
sysup_require_family() { return 0; }
_assert_eq "debup main: refuses to run on a non-Debian host" "1" "$DEBUP_STATUS"
_assert_contains "debup main: names the host it refused" \
  "only supports Debian-based hosts" "$DEBUP_RESULT"
_assert_eq "debup main: runs no apt command on the wrong family" \
  "" "$(cat "$DEBUP_APT_LOG")"

echo ""
echo "=== debup: needrestart resolution ==="

# Regression: needrestart installs into /usr/sbin, which a normal user's PATH
# omits on Debian. debup runs unprivileged and escalates per command, so
# detecting with the caller's PATH reported needrestart missing on a host where
# it was installed, and the needrestart restart path was silently never used.
_debup_reset
debup_sbin=$(_tmpdir)
# A name no host can ship, so `command -v` cannot find a real needrestart and
# the sbin search path is the only thing under test. Ubuntu and WSL images do
# install needrestart, and CI runs as root with /usr/sbin on PATH.
debup_nr_fixture="needrestart-sysup-test-fixture"
# shellcheck disable=SC2034 # read by the sourced debup under test.
DEBUP_NEEDRESTART_SEARCH_PATH="$debup_sbin"
# shellcheck disable=SC2034 # read by the sourced debup under test.
DEBUP_NEEDRESTART="$debup_nr_fixture"

set +e
debup_needrestart_path >/dev/null
status=$?
set -e
_assert_eq "debup needrestart: absent everywhere is not found" "1" "$status"

# Present only in an sbin directory the caller's PATH does not include.
printf '#!/usr/bin/env bash\nexit 0\n' >"$debup_sbin/$debup_nr_fixture"
chmod +x "$debup_sbin/$debup_nr_fixture"
set +e
resolved=$(debup_needrestart_path)
status=$?
set -e
_assert_eq "debup needrestart: found in sbin despite not being on PATH" "0" "$status"
_assert_eq "debup needrestart: resolves to an absolute path" \
  "$debup_sbin/$debup_nr_fixture" "$resolved"

# The restart hook must actually use it once resolution succeeds.
_debup_reset
# shellcheck disable=SC2034 # read by the sourced debup under test.
DEBUP_NEEDRESTART_SEARCH_PATH="$debup_sbin"
# shellcheck disable=SC2034 # read by the sourced debup under test.
DEBUP_NEEDRESTART="$debup_nr_fixture"
cat >"$debup_sbin/$debup_nr_fixture" <<EOF
#!/usr/bin/env bash
printf '%s\\n' "\$*" >>"$DEBUP_NEEDRESTART_LOG"
exit 0
EOF
chmod +x "$debup_sbin/$debup_nr_fixture"
DEBUP_MOCK_PACKAGE_FILES=$'openssh-server /usr/lib/systemd/system/ssh.service'
DEBUP_MOCK_ACTIVE_UNITS="ssh.service"
sysup_backend_restart_services openssh-server >/dev/null 2>&1
_assert_contains "debup needrestart: sbin-only needrestart drives the restart" \
  "-r a" "$(cat "$DEBUP_NEEDRESTART_LOG")"
_assert_not_contains "debup needrestart: built-in restart is not used as well" \
  "try-restart" "$(cat "$DEBUP_SYSTEMCTL_LOG")"

rm -f "$debup_sbin/$debup_nr_fixture"
# shellcheck disable=SC2034 # read by the sourced debup under test.
DEBUP_NEEDRESTART_SEARCH_PATH="/usr/local/sbin:/usr/sbin:/sbin"
# shellcheck disable=SC2034 # read by the sourced debup under test.
DEBUP_NEEDRESTART="$DEBUP_MOCK_BIN/needrestart"

_test_summary
