#!/usr/bin/env bash
# Run behavior suites sequentially. They source backends and deliberately
# redefine command names, so process isolation is part of the test contract.

set -u

TEST_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
ROOT=$(cd "$TEST_DIR/.." && pwd)
status=0

for suite in sysup-test archup-test debup-test; do
  bash "$TEST_DIR/$suite" || status=$?
done

if [[ "${SYSUP_SKIP_SHELLCHECK:-0}" != 1 ]] && command -v shellcheck >/dev/null 2>&1; then
  # Shared CI and local runs must agree about which files are production shell.
  # Read the typed inventory instead of duplicating it here, so a newly added
  # backend helper cannot silently miss one of the two lint paths.
  shell_files=()
  while IFS=$'\t' read -r record_type path ||
    [[ -n "$record_type$path" ]]; do
    if [[ "$record_type" == program ]]; then
      shell_files+=("$ROOT/$path")
    fi
  done <"$ROOT/.github/shellcheck-files.txt"

  if ((${#shell_files[@]} == 0)); then
    printf 'test/run: ShellCheck inventory has no programs\n' >&2
    status=1
  else
    (
      cd "$ROOT"
      shellcheck -x -P SCRIPTDIR "${shell_files[@]}"
    ) || status=$?
  fi
fi

exit "$status"
