#!/usr/bin/env bash
# archup - the Arch backend for sysup.
#
# Shared run sequence, systemd handling, and family detection live beside this
# private backend; this file only supplies the pacman/yay specifics.
set -Eeuo pipefail

# Read by the sysup library sourced below, for messages and the family guard.
# shellcheck disable=SC2034
SYSUP_BACKEND_NAME=archup

_archup_lib_dir() {
  local src="${BASH_SOURCE[0]}"
  (cd "$(dirname "$src")" >/dev/null 2>&1 && pwd -P)
}

# shellcheck source=common.sh
. "$(_archup_lib_dir)/common.sh"

# The confirmation flag the operator chose for this run. The upgrade hook
# records it so orphan removal prompts exactly when the upgrade did.
ARCHUP_CONFIRMATION_ARG=--noconfirm

# Upper bound on orphan-removal passes; real dependency chains are shallow.
ARCHUP_ORPHAN_PASSES="${ARCHUP_ORPHAN_PASSES:-10}"

# Where kernel packages install their modules, one directory per release.
# Overridable so tests never read the host's kernel state.
ARCHUP_MODULES_ROOT="${ARCHUP_MODULES_ROOT:-/usr/lib/modules}"

archup_is_root() {
  ((EUID == 0))
}

# A function rather than a bare `uname -r` so tests can pin the release
# without depending on the kernel the suite happens to run under.
archup_running_kernel_release() {
  uname -r
}

# Whether the operator named an AUR build user for a root run. Only the
# complete absence of one (SUDO_USER unset after `su -` or a root login, or
# root when sudo ran from a root shell) permits
# the repository-only fallback; a named but unusable user still fails closed
# in archup_yay_user, because the operator asked for AUR upgrades.
archup_aur_user_named() {
  [[ -n "${SYSUP_ARCH_USER:-}" ]] && return 0
  [[ -n "${SUDO_USER:-}" && "$SUDO_USER" != root ]]
}

archup_yay_user() {
  local user="${SYSUP_ARCH_USER:-${SUDO_USER:-}}" uid

  if [[ -z "$user" || "$user" == root ]]; then
    printf 'error: running yay as root is unsafe; set SYSUP_ARCH_USER to the non-root AUR owner\n' >&2
    return 1
  fi
  if ! uid=$(id -u -- "$user" 2>/dev/null) || [[ "$uid" == 0 ]]; then
    printf 'error: SYSUP_ARCH_USER/SUDO_USER must name an existing non-root user\n' >&2
    return 1
  fi
  printf '%s\n' "$user"
}

archup_prepare_yay() {
  local user

  archup_is_root || return 0
  user=$(archup_yay_user) || return
  sysup_need_cmds sudo || return

  # yay must build as the owning user, but its nested pacman invocation still
  # needs that user's sudo credential. Warming it through the same terminal
  # makes an interactive root shell safe and makes unattended cron fail closed.
  sudo -u "$user" -H -- sudo -v
}

archup_run_yay() {
  local user

  if ! archup_is_root; then
    yay "$@"
    return
  fi

  user=$(archup_yay_user) || return
  sudo -u "$user" -H -- yay "$@"
}

archup_loaded_nvidia_version() {
  local version_file="${ARCHUP_NVIDIA_VERSION_FILE:-/proc/driver/nvidia/version}"

  [[ -r "$version_file" ]] || return 1
  sed -n '1s/.*  \([0-9][0-9.]*\)  .*/\1/p' "$version_file"
}

archup_nvidia_version_valid() {
  [[ "$1" =~ ^[0-9]+([.][0-9]+)+$ ]]
}

# nvidia-persistenced links against the upgraded userspace library. Restarting
# it while the previous kernel module remains loaded stops a healthy daemon and
# cannot start its replacement, so leave it running until the operator reloads
# the modules or reboots.
sysup_backend_check_service_restart() {
  local unit="$1" installed loaded version_file

  [[ "$unit" == nvidia-persistenced.service ]] || return 0
  version_file="${ARCHUP_NVIDIA_VERSION_FILE:-/proc/driver/nvidia/version}"
  [[ -e "$version_file" ]] || return 0
  if [[ ! -r "$version_file" ]]; then
    printf 'warning: could not determine the loaded NVIDIA driver version; preserving %s\n' \
      "$unit"
    return 2
  fi

  loaded="$(archup_loaded_nvidia_version)" || {
    printf 'warning: could not determine the loaded NVIDIA driver version; preserving %s\n' \
      "$unit"
    return 2
  }
  if ! archup_nvidia_version_valid "$loaded"; then
    printf 'warning: could not determine the loaded NVIDIA driver version; preserving %s\n' \
      "$unit"
    return 2
  fi
  if ! installed="$(modinfo -F version nvidia 2>/dev/null)" ||
    ! archup_nvidia_version_valid "$installed"; then
    printf 'warning: could not determine the installed NVIDIA driver version; preserving %s\n' \
      "$unit"
    return 2
  fi
  [[ "$loaded" == "$installed" ]] && return 0

  printf 'deferred: loaded NVIDIA driver %s differs from installed %s; reload NVIDIA modules or reboot before restarting %s\n' \
    "$loaded" "$installed" "$unit"
  return 1
}

sysup_backend_usage() {
  cat <<'EOF'
Usage: sysup [--no-autoremove] [--check-only]
             [--no-restart-upgraded-services] [--restart-failed]
             [-- yay/pacman args...]

Upgrade an Arch host, rebuilding broken AUR packages when yay is available,
then verify the failure modes most likely to leave services broken after the
upgrade.

Default flow:
  1. report installed foreign packages
  2. warm sudo credentials
  3. upgrade packages noninteractively with yay, or pacman when yay is absent
  4. rebuild installed AUR packages whose ELF files have missing libraries
  5. remove orphaned dependencies no installed package still requires,
     counting optional dependencies as required
  6. check shared libraries, report pending .pacnew/.pacsave merges, and
     report whether the running kernel needs a reboot
  7. restart active services shipped by packages upgraded or rebuilt in this run
  8. optionally restart failed enabled units with --restart-failed
  9. report failed systemd units when systemd is available

Options:
EOF
  sysup_usage_common_options
  cat <<'EOF'

Arguments after -- are passed to both yay upgrade and automatic AUR rebuild
invocations, or to the pacman fallback. Package installation is noninteractive
by default; pass --confirm after -- to restore package-manager prompts.

When invoked as root, yay runs as the non-root user named by SYSUP_ARCH_USER,
or by SUDO_USER when SYSUP_ARCH_USER is unset. The user must be able to
authenticate sudo interactively; unattended root AUR upgrades fail closed
instead of building packages as root. With yay installed, SYSUP_ARCH_USER
naming root or a missing user is an error. When neither variable names a
non-root user, AUR packages are skipped with a warning and pacman upgrades
repository packages only.
EOF
}

# Installed packages no sync repository provides (AUR and local builds), sorted.
# Like orphan_packages, pacman exits 1 both when nothing matches (a host with
# no AUR packages) and on a real error, so only an `error:` line under the C
# locale marks the query as failed; warnings pass through to stderr.
foreign_packages() {
  local errors error_text output status=0

  errors=$(mktemp) || return 2
  output=$(LC_ALL=C pacman -Qqm 2>"$errors") || status=$?
  error_text=$(<"$errors")
  rm -f "$errors"
  [[ -z "$error_text" ]] || printf '%s\n' "$error_text" >&2
  if ((status > 1)) || { ((status == 1)) &&
    { [[ -n "$output" ]] || [[ $'\n'"$error_text" == *$'\n'error:* ]]; }; }; then
    return 2
  fi
  [[ -z "$output" ]] || printf '%s\n' "$output" | sort
}

aur_rebuild_targets() {
  local pkg lookup_status status=0

  while IFS= read -r pkg; do
    [[ -n "$pkg" ]] || continue
    if _archup_aur_package_status "$pkg"; then
      printf '%s\n' "$pkg"
      continue
    else
      lookup_status=$?
    fi

    ((lookup_status == 1)) && continue
    printf 'warning: could not verify whether %s can be rebuilt from AUR; skipped automatic rebuild\n' \
      "$pkg" >&2
    status=2
  done

  return "$status"
}

# yay reports every requested package as missing when the AUR query itself
# fails. Under a stable C locale, a lone "not found" diagnostic proves absence;
# any additional diagnostic means membership is unverified instead.
#
# Returns 0 when present, 1 when confirmed absent, and 2 when the lookup failed.
_archup_aur_package_status() {
  local pkg="$1" output line other_output=""
  local saw_missing=0 saw_other=0

  if output="$(LC_ALL=C NO_COLOR=1 archup_run_yay -Si --aur "$pkg" 2>&1)"; then
    return 0
  fi

  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    if [[ "$line" == *"No AUR package found for"* && "$line" == *"$pkg"* ]]; then
      saw_missing=1
      continue
    fi

    other_output+="${other_output:+$'\n'}$line"
    saw_other=1
  done <<<"$output"

  if ((saw_missing && saw_other == 0)); then
    return 1
  fi

  if [[ -n "$other_output" ]]; then
    printf '%s\n' "$other_output" >&2
  else
    printf 'yay could not query AUR package %s and returned no diagnostic\n' "$pkg" >&2
  fi
  return 2
}

# Foreign packages missing from the AUR cannot be rebuilt automatically, so the
# operator has to know they are now their own responsibility.
warn_non_aur_foreign_packages() {
  local packages pkg lookup_status
  local missing_found=0 unverified_found=0

  if ! packages="$(foreign_packages)"; then
    printf 'warning: could not list foreign packages; AUR membership is unverified\n' >&2
    return 0
  fi

  while IFS= read -r pkg; do
    [[ -n "$pkg" ]] || continue
    if _archup_aur_package_status "$pkg"; then
      continue
    else
      lookup_status=$?
    fi

    if ((lookup_status == 1)); then
      if ((missing_found == 0)); then
        sysup_log "foreign packages not found in AUR"
        missing_found=1
      fi
      printf '  %s\n' "$pkg"
      continue
    fi

    if ((unverified_found == 0)); then
      sysup_log "could not verify AUR membership for foreign packages"
      unverified_found=1
    fi
    printf '  %s\n' "$pkg"
  done <<<"$packages"
}

# A repository upgrade can bump a shared library past the soname an AUR package
# was built against. The package still looks installed and current, but its
# binaries no longer load, so scan the ones built locally.
scan_foreign_package_libs() {
  local mode="${1:-report}"
  local packages pkg listing file described desc dependencies missing line
  local found=0 pkg_printed index
  local -a files=() descs=()

  if ! packages="$(foreign_packages)"; then
    printf 'error: could not list foreign packages; missing-library state is unverified\n' >&2
    return 2
  fi

  while IFS= read -r pkg; do
    [[ -n "$pkg" ]] || continue
    pkg_printed=0

    if ! listing="$(pacman -Qlq "$pkg")"; then
      printf 'error: could not list files owned by %s; missing-library state is unverified\n' \
        "$pkg" >&2
      return 2
    fi

    files=()
    while IFS= read -r file; do
      [[ -f "$file" ]] && files+=("$file")
    done <<<"$listing"
    ((${#files[@]})) || continue

    # One `file` process per package rather than per file: the scan runs
    # twice per run over every file of every foreign package, and process
    # startup dominated it.
    if ! described="$(_archup_describe_files "${files[@]}")"; then
      printf 'error: could not identify files owned by %s with file; missing-library state is unverified\n' \
        "$pkg" >&2
      return 2
    fi
    descs=()
    mapfile -t descs <<<"$described"
    # Each description is one line, so only an empty last description (which
    # command substitution drops) can leave the counts unequal.
    if ((${#descs[@]} != ${#files[@]})); then
      printf 'error: could not identify files owned by %s with file; missing-library state is unverified\n' \
        "$pkg" >&2
      return 2
    fi

    for index in "${!files[@]}"; do
      file="${files[index]}"
      desc="${descs[index]}"
      [[ "$desc" == *ELF* ]] || continue
      # Static executables and relocatable objects have no runtime shared-library
      # dependencies; ldd legitimately rejects them.
      [[ "$desc" == *"dynamically linked"* ]] || continue
      # Separated debug info is never loaded at runtime, so it has no library
      # dependencies to verify. It still reports itself as dynamically linked
      # (with an empty interpreter), so the check above does not exclude it and
      # ldd rejects it. Every `*-debug` package ships these, which makes them
      # common among foreign packages.
      case "$file" in
        /usr/lib/debug/* | *.debug) continue ;;
      esac

      if ! dependencies="$(ldd "$file")"; then
        printf 'error: could not inspect shared-library dependencies for %s; state is unverified\n' \
          "$file" >&2
        return 2
      fi

      missing=""
      while IFS= read -r line; do
        [[ "$line" == *"not found"* ]] || continue
        missing+="${missing:+$'\n'}$line"
      done <<<"$dependencies"
      [[ -n "$missing" ]] || continue

      if [[ "$mode" == "packages" ]]; then
        if ((pkg_printed == 0)); then
          printf '%s\n' "$pkg"
          pkg_printed=1
        fi
        found=1
        continue
      fi

      if ((pkg_printed == 0)); then
        printf 'broken libraries in %s:\n' "$pkg"
        pkg_printed=1
      fi

      printf '  %s\n' "$file"
      while IFS= read -r line; do
        printf '    %s\n' "$line"
      done <<<"$missing"
      found=1
    done
  done <<<"$packages"

  ((found == 0))
}

# Print one `file` description per line for the files named in "$@", in
# order, or fail when `file` fails or its output cannot be paired with them.
#
# Names go in on stdin (-f -) instead of argv, so a large package cannot
# exceed the argument-length limit, and the shell fixtures in the tests still
# intercept the call (xargs would exec the real binary). pacman's listing is
# newline-delimited, so no owned name contains a newline, which is all -f
# needs. -N drops alignment padding and -r keeps name bytes raw so each name
# matches what was sent.
_archup_describe_files() {
  printf '%s\n' "$@" | file -N -r -0 -f - | _archup_pair_file_output "$@"
}

# Pair `file -N -r -0` output with the names in "$@".
#
# Each record is "name\0: description\n". Under -r the description is raw too,
# and it quotes file contents (an ELF interpreter string, say), so it can hold
# a newline or ": ", and neither can delimit records. A NUL can appear in
# neither a name nor a description, so the stream splits on NUL into the first
# name, then one ": description\n<next name>" chunk per file, the last without
# a following name. Every chunk must match the name expected next; any other
# shape leaves the pairing unknown, and attributing a description to the wrong
# file could hide a broken binary. Descriptions are printed with newlines
# folded to spaces: callers match substrings and need one line per file.
_archup_pair_file_output() {
  local -a names=("$@")
  local chunk desc next index

  IFS= read -r -d '' chunk || return 1
  [[ "$chunk" == "${names[0]}" ]] || return 1
  for ((index = 0; index < ${#names[@]}; index++)); do
    if ((index + 1 < ${#names[@]})); then
      IFS= read -r -d '' chunk || return 1
      next="${names[index + 1]}"
      [[ "$chunk" == ": "*$'\n'"$next" ]] || return 1
      desc="${chunk%$'\n'"$next"}"
    else
      # The last record runs to end of input; a further NUL means extra output.
      if IFS= read -r -d '' chunk; then
        return 1
      fi
      [[ "$chunk" == ": "*$'\n' ]] || return 1
      desc="${chunk%$'\n'}"
    fi
    desc="${desc#: }"
    printf '%s\n' "${desc//$'\n'/ }"
  done
}

broken_foreign_packages() {
  local status=0

  scan_foreign_package_libs packages || status=$?
  case "$status" in
    0 | 1) return 0 ;;
    *) return "$status" ;;
  esac
}

scan_missing_libs() {
  local status=0

  sysup_log "checking foreign packages for missing shared libraries"

  scan_foreign_package_libs report || status=$?
  case "$status" in
    0)
      printf 'ok: no missing shared libraries found in foreign packages\n'
      return 0
      ;;
    1)
      printf '\nerror: at least one foreign package has missing libraries\n' >&2
      return 1
      ;;
    *)
      printf '\nerror: could not complete the foreign-package library scan\n' >&2
      return 1
      ;;
  esac
}

# Print orphans: packages installed as dependencies that nothing requires.
#
# A single -t still counts optional dependencies as required, so an optdepend
# the operator relies on is never treated as unused. pacman exits 1 both when
# there are no orphans and on a real error, and prints harmless warnings (an
# unrecognized pacman.conf directive, say) on any run, so only an `error:`
# line under the C locale marks the query as failed.
orphan_packages() {
  local errors error_text output status=0

  errors=$(mktemp) || return 2
  output=$(LC_ALL=C pacman -Qdtq 2>"$errors") || status=$?
  error_text=$(<"$errors")
  rm -f "$errors"
  [[ -z "$error_text" ]] || printf '%s\n' "$error_text" >&2
  if ((status > 1)) || { ((status == 1)) &&
    { [[ -n "$output" ]] || [[ $'\n'"$error_text" == *$'\n'error:* ]]; }; }; then
    return 2
  fi
  [[ -z "$output" ]] || printf '%s\n' "$output"
}

report_pending_pacman_configs() {
  local listing
  local -a configs=()

  sysup_log "checking for pending package configuration"
  if ! command -v pacdiff >/dev/null 2>&1; then
    printf 'warning: could not scan for config files awaiting a manual merge; install pacman-contrib\n' >&2
    return 0
  fi
  if ! listing=$(pacdiff --output); then
    printf 'warning: could not scan for config files awaiting a manual merge\n' >&2
    return 0
  fi
  if [[ -n "$listing" ]]; then
    mapfile -t configs <<<"$listing"
    printf 'config files awaiting a manual merge:\n'
    printf '  %s\n' "${configs[@]}"
  else
    printf 'ok: no config files awaiting a manual merge\n'
  fi
}

# Arch keeps one kernel per package, so upgrading it deletes the running
# release's module directory. The running kernel then cannot load a module it
# has not already loaded (a USB drive's filesystem, a VPN's tunnel device), so
# a missing directory is exactly the state a reboot resolves. Arch writes no
# reboot-required flag the way Ubuntu does, so this is the direct signal.
#
# Test the release's kernel/ tree, not the release directory: pacman removes
# a directory only once it is empty, so unowned leftovers (depmod's index
# files, DKMS's updates/) keep it alive after the package is gone. Both Arch
# kernel packages and `make modules_install` create kernel/, and DKMS never
# writes there.
#
# Return 0 when a reboot is required, 1 when not, 2 when it cannot be told.
# The modules root itself missing (a container, which runs the host's kernel)
# says nothing about this host's kernel, so it is unknown rather than
# "required".
archup_reboot_required() {
  local release

  release="$(archup_running_kernel_release 2>/dev/null)" || return 2
  [[ -n "$release" ]] || return 2
  [[ -d "$ARCHUP_MODULES_ROOT" ]] || return 2
  [[ -d "$ARCHUP_MODULES_ROOT/$release/kernel" ]] && return 1
  return 0
}

# Advisory, like debup's report: a pending reboot is the expected result of a
# kernel upgrade, not a failure, so it never changes the exit status.
report_reboot_required() {
  local status=0

  sysup_log "checking whether a reboot is required"
  archup_reboot_required || status=$?
  case "$status" in
    0) printf 'reboot required to complete this upgrade\n' ;;
    1) printf 'ok: no reboot required\n' ;;
    *)
      printf 'warning: could not determine whether a reboot is required; the running kernel release or %s is unavailable\n' \
        "$ARCHUP_MODULES_ROOT" >&2
      ;;
  esac
}

# ---------------------------------------------------------------------------
# sysup backend hooks
# ---------------------------------------------------------------------------

sysup_backend_require() {
  sysup_require_family arch || return
  sysup_need_cmds pacman file ldd sort
}

sysup_backend_preamble() {
  local -a packages=()
  local package_listing

  if ! package_listing="$(foreign_packages)"; then
    printf 'error: could not list foreign packages\n' >&2
    return 1
  fi
  if [[ -n "$package_listing" ]]; then
    mapfile -t packages <<<"$package_listing"
  fi
  sysup_log "foreign packages (${#packages[@]})"
  if ((${#packages[@]})); then
    printf '  %s\n' "${packages[@]}"
  else
    printf '  (none)\n'
  fi
}

sysup_backend_snapshot() {
  pacman -Q | sort
}

sysup_backend_package_files() {
  pacman -Qlq "$1"
}

sysup_backend_checks() {
  local status=0

  scan_missing_libs || status=$?
  # Advisory: pending config merges and a pending reboot are expected output
  # from a successful upgrade, so neither changes the exit status.
  report_pending_pacman_configs
  report_reboot_required
  return "$status"
}

sysup_backend_autoremove_safe() {
  local arg
  for arg in "$@"; do
    # These affect prompting only, and removal inherits the normalized choice.
    case "$arg" in
      --confirm | --noconfirm) ;;
      *) return 1 ;;
    esac
  done
  return 0
}

sysup_backend_autoremove() {
  local mode="$1" listing
  local -a orphans=()

  if ! listing=$(orphan_packages); then
    # Only a removal that cannot run fails the run; a listing is advisory,
    # matching debup's report.
    if [[ "$mode" == report ]]; then
      printf 'warning: could not list orphaned packages\n' >&2
      return 0
    fi
    printf 'error: could not list orphaned packages\n' >&2
    return 1
  fi
  if [[ -z "$listing" ]]; then
    printf 'ok: no orphaned packages to remove\n'
    return 0
  fi
  mapfile -t orphans <<<"$listing"

  if [[ "$mode" == report ]]; then
    sysup_log "orphaned packages (${#orphans[@]})"
    printf '  %s\n' "${orphans[@]}"
    printf '\nhint: run sysup without --no-autoremove to remove them\n'
    return 0
  fi

  # Removal runs through pacman as root even when yay is installed: orphans
  # need no build step, so there is no reason to involve the AUR user. -n drops
  # config backups, matching debup's purge.
  #
  # Not -s: its recursive removal follows hard dependencies only, so it would
  # take a dependency that another package still lists as optional. Removing
  # one layer and re-querying keeps -Qdt's optional-dependency protection. Each
  # pass removes at least one package, so the bound only guards a pacman that
  # keeps reporting orphans it does not remove.
  local pass
  for ((pass = 1; pass <= ARCHUP_ORPHAN_PASSES; pass++)); do
    sysup_log "removing orphaned packages (${#orphans[@]})"
    printf '  %s\n' "${orphans[@]}"
    sysup_run_as_root pacman -Rn "$ARCHUP_CONFIRMATION_ARG" -- "${orphans[@]}" || return

    if ! listing=$(orphan_packages); then
      printf 'error: could not list orphaned packages after removal\n' >&2
      return 1
    fi
    [[ -n "$listing" ]] || return 0
    mapfile -t orphans <<<"$listing"
  done

  printf 'error: orphaned packages remain after %s removal passes\n' "$ARCHUP_ORPHAN_PASSES" >&2
  return 1
}

sysup_backend_upgrade() {
  local confirmation_arg=--noconfirm arg
  local -a upgrade_args=()
  local -a yay_install_args=()
  local -a broken_packages=()
  local -a rebuild_targets=()
  local broken_output="" rebuild_output=""
  local scan_status=0 rebuild_status=0 repo_only=0

  # yay tracks its own no-confirm state separately from the options it passes
  # to pacman, so giving it both flags restores pacman's prompt but not yay's
  # menus. Normalize the pair so the caller's last choice controls both.
  for arg in "$@"; do
    case "$arg" in
      --confirm | --noconfirm) confirmation_arg="$arg" ;;
      *) upgrade_args+=("$arg") ;;
    esac
  done
  upgrade_args=("$confirmation_arg" "${upgrade_args[@]}")
  ARCHUP_CONFIRMATION_ARG="$confirmation_arg"

  SYSUP_EXTRA_UPGRADED_PACKAGES=()

  if ! command -v yay >/dev/null 2>&1; then
    sysup_log "yay not found; upgrading repository packages only"
    repo_only=1
  elif archup_is_root && ! archup_aur_user_named; then
    # A root shell from `su -` or a root login names no build user, and yay
    # must never build as root. Failing the whole run would leave repository
    # packages (and their security fixes) unapplied as well, so upgrade those
    # and say plainly that AUR packages were left alone.
    printf 'warning: running as root with no non-root AUR user (set SYSUP_ARCH_USER); skipping AUR packages because yay must not build as root\n' >&2
    sysup_log "upgrading repository packages only"
    repo_only=1
  fi
  if ((repo_only)); then
    sysup_run_as_root pacman -Syu "${upgrade_args[@]}"
    return
  fi

  # From root, yay runs as the build user and reaches pacman through that
  # user's sudo, warmed once by archup_prepare_yay. sudo's credential cache
  # expires (5 minutes by default) during a long AUR build, and the nested
  # prompt then stalls the run or fails it unattended. --sudoloop makes yay
  # refresh the credential in the background. A non-root run is deliberately
  # left to a generic sudo keeper in the shared driver rather than a yay flag,
  # so only this path passes it.
  if archup_is_root; then
    yay_install_args+=(--sudoloop)
  fi

  archup_prepare_yay || return
  archup_run_yay -Syu --devel \
    "${yay_install_args[@]+"${yay_install_args[@]}"}" "${upgrade_args[@]}" || return

  broken_output="$(broken_foreign_packages)" || scan_status=$?
  if ((scan_status != 0)); then
    printf 'warning: automatic AUR rebuild scan was incomplete; continuing to post-upgrade checks\n' >&2
    warn_non_aur_foreign_packages
    return 0
  fi
  if [[ -n "$broken_output" ]]; then
    mapfile -t broken_packages <<<"$broken_output"
  fi
  if ((${#broken_packages[@]} == 0)); then
    sysup_log "no broken foreign package libraries found after upgrade"
    warn_non_aur_foreign_packages
    return
  fi

  rebuild_output="$(printf '%s\n' "${broken_packages[@]}" | aur_rebuild_targets)" || rebuild_status=$?
  if [[ -n "$rebuild_output" ]]; then
    mapfile -t rebuild_targets <<<"$rebuild_output"
  fi
  if ((${#rebuild_targets[@]})); then
    sysup_log "rebuilding broken AUR packages (${#rebuild_targets[@]})"
    printf '  %s\n' "${rebuild_targets[@]}"
    # yay can install one target and fail later (another target or a hook).
    # Mark every attempted same-version rebuild before invoking it so the
    # driver's best-effort failure path restarts any service that did change.
    # Restarting an untouched active service is the safe conservative case.
    SYSUP_EXTRA_UPGRADED_PACKAGES+=("${rebuild_targets[@]}")
    archup_run_yay -S --aur --rebuild --redownload --answerclean All \
      "${yay_install_args[@]+"${yay_install_args[@]}"}" \
      "${upgrade_args[@]}" "${rebuild_targets[@]}" || return
  elif ((rebuild_status == 0)); then
    sysup_log "broken foreign packages are not available in AUR"
  fi

  warn_non_aur_foreign_packages
  return
}

if [[ "${SYSUP_SOURCE_ONLY:-0}" != 1 ]]; then
  sysup_main "$@"
fi
