#!/usr/bin/env bash
# dnfup - the Fedora/RHEL backend for sysup.
#
# Shared run sequence, systemd handling, and family detection live beside this
# private backend; this file only supplies the dnf/rpm specifics.
#
# This upgrades packages within the installed release. It never runs
# `dnf system-upgrade` and never changes the configured release version.
set -Eeuo pipefail

# Read by the sysup library sourced below, for messages and the family guard.
# shellcheck disable=SC2034
SYSUP_BACKEND_NAME=dnfup

_dnfup_lib_dir() {
  local src="${BASH_SOURCE[0]}"
  (cd "$(dirname "$src")" >/dev/null 2>&1 && pwd -P)
}

# shellcheck source=common.sh
. "$(_dnfup_lib_dir)/common.sh"
# shellcheck source=rpm.sh
. "$(_dnfup_lib_dir)/rpm.sh"

# Present on hosts booted from an rpm-ostree or bootc image (Fedora Atomic
# desktops, CoreOS, image-mode RHEL). Overridable so tests can point it at a
# fixture instead of the live system.
DNFUP_OSTREE_BOOTED_FILE="${DNFUP_OSTREE_BOOTED_FILE:-/run/ostree-booted}"

# Where packages are pinned: dnf.conf's [main] excludes, and the versionlock
# list each dnf generation keeps (dnf4's plugin and dnf5's built-in command use
# different files and formats). Overridable for tests.
DNFUP_CONF="${DNFUP_CONF:-/etc/dnf/dnf.conf}"
DNFUP_VERSIONLOCK_LIST="${DNFUP_VERSIONLOCK_LIST:-/etc/dnf/plugins/versionlock.list}"
DNFUP_VERSIONLOCK_TOML="${DNFUP_VERSIONLOCK_TOML:-/etc/dnf/versionlock.toml}"

# The rpm transaction lock. dnf4 waits for it, but dnf5 fails at once while
# another transaction (dnf-automatic, PackageKit) holds it. Empty means ask rpm.
DNFUP_RPM_LOCK="${DNFUP_RPM_LOCK:-}"
DNFUP_LOCK_TIMEOUT="${DNFUP_LOCK_TIMEOUT:-300}"

sysup_backend_usage() {
  cat <<'EOF'
Usage: sysup [--no-autoremove] [--check-only]
             [--no-restart-upgraded-services] [--restart-failed]
             [-- dnf args...]

Upgrade a Fedora or RHEL-family host within its installed release, then verify
the failure modes most likely to leave services broken after the upgrade.

Default flow:
  1. report versionlocked and excluded packages
  2. warm sudo credentials
  3. wait for another rpm transaction to finish, then refresh metadata and
     upgrade packages noninteractively
  4. remove packages no longer required
  5. run dnf check, pending-config, and reboot-required checks
  6. restart active services shipped by packages upgraded in this run
  7. optionally restart failed enabled units with --restart-failed
  8. report failed systemd units when systemd is available

Options:
EOF
  sysup_usage_common_options
  cat <<'EOF'

Arguments after -- are passed through to the dnf upgrade invocation. Package
installation is noninteractive by default.

dnfup never performs a release upgrade; use `dnf system-upgrade` or the
distribution's documented procedure for that.
EOF
}

dnfup_dnf() {
  sysup_run_as_root dnf "$@"
}

# dnf for questions answered from the installed rpmdb alone. Repositories are
# disabled because dnf otherwise loads every enabled repo first, and a load
# failure (offline host, expired cache, mirror down) exits with the same status
# these commands use for their findings.
dnfup_dnf_local() {
  dnfup_dnf --disablerepo='*' "$@"
}

# Return 0 when a reboot is required, 1 when not, 2 when it cannot be told.
#
# `needs-restarting` ships in dnf-plugins-core (dnf4) and dnf5-plugins. It
# exits 1 when a reboot is needed and 0 when not. dnf4 needs -r to select the
# reboot check; dnf5 makes it the default and accepts -r for compatibility.
# dnf also exits 1 for an unknown command, so a host without the plugin would
# read as "reboot required"; probe for the command first rather than parsing
# its prose.
#
# With repositories disabled, dnf5 consults only its built-in core-package
# list, not the reboot_suggested flags in repository advisories. That trade is
# deliberate: a repository that fails to load would exit 1 and read as "reboot
# required". The "ok" message therefore says what was actually checked.
dnfup_reboot_required() {
  local status=0

  dnfup_dnf_local needs-restarting --help >/dev/null 2>&1 || return 2
  dnfup_dnf_local needs-restarting -r >/dev/null 2>&1 || status=$?
  case "$status" in
    0) return 1 ;;
    1) return 0 ;;
  esac
  return 2
}

# `dnf check` in both dnf4 and dnf5 reports unsatisfied dependencies, duplicate
# packages, and obsoleted packages still installed. Duplicates are the usual
# remains of an interrupted transaction, which `rpm -Va` does not detect.
check_package_integrity() {
  sysup_log "checking package database integrity"
  if dnfup_dnf_local check; then
    printf 'ok: dnf check reports a consistent package database\n'
    return 0
  fi
  # A database open or privilege failure also exits non-zero, so do not
  # assert a cause the status alone does not establish.
  printf '\nerror: dnf check failed; see its output above; package database state is unverified\n' >&2
  return 1
}

# Advisory: the upgrade succeeded, but its result is not fully live yet.
report_pending_state() {
  local reboot_status=0

  sysup_log "checking for pending post-upgrade work"

  if dnfup_reboot_required; then
    printf 'reboot required to complete this upgrade\n'
  else
    reboot_status=$?
    if ((reboot_status == 1)); then
      printf 'ok: no reboot required by packages updated since boot (repository advisories not consulted)\n'
    else
      printf 'warning: could not determine whether a reboot is required; install or repair the dnf needs-restarting plugin and check again\n' >&2
    fi
  fi

  sysup_rpm_report_pending_conffiles
}

# ---------------------------------------------------------------------------
# sysup backend hooks
# ---------------------------------------------------------------------------

sysup_backend_require() {
  sysup_require_family fedora || return

  # dnf refuses to change a read-only image-based root, so the upgrade would
  # fail late with a generic error. Name the right tool before starting.
  if [[ -e "$DNFUP_OSTREE_BOOTED_FILE" ]]; then
    printf "error: this host boots from an rpm-ostree or bootc image; upgrade it with 'rpm-ostree upgrade' or 'bootc upgrade'\n" >&2
    return 1
  fi

  # RHEL/CentOS 7 and Amazon Linux 2 match the family but ship only yum.
  if ! command -v dnf >/dev/null 2>&1 && command -v yum >/dev/null 2>&1; then
    printf 'error: this host has yum but not dnf; dnfup supports dnf-based releases only\n' >&2
    return 1
  fi
  sysup_need_cmds dnf rpm find sort
}

# The rpm database is shared with zypup, so rpm.sh owns the snapshot format
# (NAME.ARCH keys, epochs, joined installonly versions, no signing keys).
sysup_backend_snapshot() {
  sysup_rpm_snapshot
}

sysup_backend_package_files() {
  sysup_rpm_package_files "$1"
}

sysup_backend_checks() {
  local status=0

  check_package_integrity || status=1
  # Advisory: a pending reboot or unmerged config file is expected output from a
  # successful upgrade, not a failure, so it never changes the exit status.
  report_pending_state
  return "$status"
}

# Autoremove removes packages whose recorded install reason is "dependency".
# The running kernel is guarded by protect_running_kernel, which makes the
# transaction fail rather than skip it, so a wrongly recorded kernel surfaces as
# a failed cleanup instead of an unbootable host.
sysup_backend_autoremove() {
  local listing
  local -a unneeded=()

  if [[ "$1" == report ]]; then
    # A listing is advisory, matching the other backends' reports.
    # stderr stays on the terminal: dnf warnings must not read as packages.
    if ! listing="$(dnfup_dnf_local -q repoquery --unneeded)"; then
      printf 'warning: could not determine which packages are no longer required\n' >&2
      return 0
    fi
    if [[ -z "$listing" ]]; then
      printf 'ok: no packages are eligible for autoremove\n'
      return 0
    fi
    mapfile -t unneeded <<<"$listing"
    sysup_log "packages no longer required"
    printf '  %s\n' "${unneeded[@]}"
    printf '\nhint: run sysup without --no-autoremove to remove them\n'
    return 0
  fi

  sysup_log "removing packages no longer required"
  dnfup_dnf autoremove -y
}

# Print the packages dnf will not upgrade, one per line, each marked with why:
# `(versionlock)` or `(excluded)`. Reads the files directly: `dnf versionlock
# list` needs a plugin on dnf4 and loads repositories, and an informational
# list must not fail on either. Repository-level excludes are not covered.
dnfup_pinned_packages() {
  local line section="" item
  local -a items=()

  if [[ -e "$DNFUP_CONF" ]]; then
    [[ -r "$DNFUP_CONF" ]] || return 1
    # `exclude` is the old spelling of `excludepkgs`; both take a comma- or
    # space-separated list, and only the [main] section applies globally.
    while IFS= read -r line || [[ -n "$line" ]]; do
      if [[ "$line" =~ ^[[:space:]]*\[([^]]*)\] ]]; then
        section="${BASH_REMATCH[1]}"
        continue
      fi
      [[ "$section" == main ]] || continue
      [[ "$line" =~ ^[[:space:]]*(excludepkgs|exclude)[[:space:]]*=(.*)$ ]] || continue
      # read -a splits without globbing, so a `kernel*` pattern stays literal.
      read -ra items <<<"${BASH_REMATCH[2]//,/ }"
      for item in ${items[@]+"${items[@]}"}; do
        printf '%s (excluded)\n' "$item"
      done
    done <"$DNFUP_CONF"
  fi

  # dnf4: one NEVRA pattern per line; a leading `!` marks an exclude entry.
  if [[ -e "$DNFUP_VERSIONLOCK_LIST" ]]; then
    [[ -r "$DNFUP_VERSIONLOCK_LIST" ]] || return 1
    while IFS= read -r line; do
      line="${line%%#*}"
      line="${line//[[:space:]]/}"
      [[ -n "$line" ]] || continue
      if [[ "$line" == '!'* ]]; then
        printf '%s (excluded)\n' "${line#!}"
      else
        printf '%s (versionlock)\n' "$line"
      fi
    done <"$DNFUP_VERSIONLOCK_LIST"
  fi

  # dnf5: TOML with one `name = "..."` per [[packages]] table.
  if [[ -e "$DNFUP_VERSIONLOCK_TOML" ]]; then
    [[ -r "$DNFUP_VERSIONLOCK_TOML" ]] || return 1
    while IFS= read -r line; do
      [[ "$line" =~ ^[[:space:]]*name[[:space:]]*=[[:space:]]*\"([^\"]+)\" ]] || continue
      printf '%s (versionlock)\n' "${BASH_REMATCH[1]}"
    done <"$DNFUP_VERSIONLOCK_TOML"
  fi
}

# Informational, like held packages elsewhere: an unreadable file is a warning
# and never stops the run.
sysup_backend_preamble() {
  local -a pinned=()
  local listing

  if ! listing="$(dnfup_pinned_packages)"; then
    printf 'warning: could not read the dnf exclude or versionlock configuration\n' >&2
    return 0
  fi
  [[ -z "$listing" ]] || mapfile -t pinned <<<"$listing"
  sysup_log "versionlocked and excluded packages (${#pinned[@]})"
  if ((${#pinned[@]})); then
    printf '  %s\n' "${pinned[@]}"
  else
    printf '  (none)\n'
  fi
}

dnfup_rpm_lock_path() {
  local path="$DNFUP_RPM_LOCK"

  [[ -n "$path" ]] || path=$(rpm --eval '%{_rpmlock_path}' 2>/dev/null) || path=""
  # An unexpanded macro comes back verbatim.
  [[ -n "$path" && "$path" != *%* ]] || path=/var/lib/rpm/.rpm.lock
  printf '%s\n' "$path"
}

# Return 0 when another process holds the rpm transaction lock, 1 otherwise.
#
# rpm keeps its lock file open for the life of a transaction set, after the
# lock itself is released, so an open descriptor alone would make an idle
# PackageKit or dnf5daemon look like a holder for as long as it runs. Held
# means a process has the file open and /proc/locks shows a write lock on its
# inode. The inode alone is compared: /proc/locks devices do not match stat()
# on btrfs, and requiring an open descriptor too keeps an inode collision
# with another subvolume's locked file from mattering. When /proc/locks
# cannot be read, the open descriptor is taken as the holder.
dnfup_rpm_lock_held() {
  local path="$1" inode

  sysup_path_in_use "$path" || return 1
  # `ls -di` rather than `stat`, whose flags differ between GNU and BSD.
  inode=$(ls -di "$path" 2>/dev/null) || return 1
  inode="${inode%% *}"
  [[ -r "$SYSUP_PROC_ROOT/locks" ]] || return 0
  # Fields: id, type, mode, access, pid, major:minor:inode, start, end. A
  # waiting request carries `->` after the id, which shifts its access field
  # out of $4, so only granted write locks match.
  awk -v inode="$inode" '
    $4 == "WRITE" { n = split($6, dev, ":"); if (dev[n] == inode) found = 1 }
    END { exit !found }
  ' "$SYSUP_PROC_ROOT/locks"
}

sysup_backend_upgrade() {
  sysup_wait_path_free "$(dnfup_rpm_lock_path)" "$DNFUP_LOCK_TIMEOUT" \
    "the rpm transaction lock" dnfup_rpm_lock_held || return 1
  dnfup_dnf upgrade --refresh -y "$@"
}

if [[ "${SYSUP_SOURCE_ONLY:-0}" != 1 ]]; then
  sysup_main "$@"
fi
